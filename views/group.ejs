<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> - グループ概要</title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <link rel="stylesheet" href="/css/ui-states.css">
  <script src="/js/ui-accessibility.js" defer></script>
</head>
<body class="ledger-body">
  <%- include("partials/app-header", {
    header: {
      mode: "group",
      groupId: group.id,
      active: "overview"
    }
  }) %>

  <% if (error || success) { %>
    <section class="flash-area" role="region" aria-label="操作結果" aria-live="polite" aria-atomic="true">
      <% if (error) { %>
        <p class="error-message ui-state-message" data-ui-state="error" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message ui-state-message" data-ui-state="success" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <main class="group-overview-stack">
    <section class="panel group-basic-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">基本情報</p>
          <h2>グループ情報</h2>
        </div>
        <span><%= group.isActive ? "有効" : "無効" %></span>
      </div>

      <dl class="group-definition-list">
        <div>
          <dt>グループ名</dt>
          <dd><%= group.name %></dd>
        </div>
        <div>
          <dt>自分の権限</dt>
          <dd><%= membership.role === "ADMIN" ? "グループ管理者" : "メンバー" %></dd>
        </div>
        <div>
          <dt>有効メンバー</dt>
          <dd><%= activeMemberCount %> 人</dd>
        </div>
        <div>
          <dt>有効な管理者</dt>
          <dd><%= activeAdminCount %> 人</dd>
        </div>
      </dl>

      <% if (isAdmin) { %>
        <section class="group-basic-admin-section" aria-labelledby="group-name-heading">
          <h3 id="group-name-heading">グループ名を変更</h3>
          <form
            action="/groups/<%= group.id %>/name"
            method="post"
            class="page-form group-name-form"
          >
            <label>
              <span>グループ名</span>
              <input
                type="text"
                name="name"
                value="<%= group.name %>"
                maxlength="100"
                required
              >
            </label>
            <p class="form-help">
              前後の空白は保存時に取り除きます。同名のグループも使用できます。
            </p>
            <button type="submit" class="primary-button">グループ名を保存</button>
          </form>
        </section>
      <% } %>
    </section>

    <div class="group-feature-grid">
      <section class="panel group-feature-card group-fund-card">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">基金</p>
            <h2>グループ基金</h2>
          </div>
          <span>表示可能</span>
        </div>

        <% if (fund) { %>
          <dl class="group-definition-list">
            <div>
              <dt>基金名</dt>
              <dd><%= fund.name %></dd>
            </div>
            <div>
              <dt>状態</dt>
              <dd><%= fund.isActive ? "有効" : "無効" %></dd>
            </div>
          </dl>
        <% } else { %>
          <p class="error-message ui-state-message" data-ui-state="error" role="alert">このグループの基金が見つかりません。</p>
        <% } %>

        <% const fundPage = ledgerPages.find(page => page.pageType === "GROUP_FUND"); %>
        <p class="group-feature-page">
          初期ページ：
          <strong><%= fundPage ? fundPage.name : "未作成" %></strong>
        </p>
        <% if (fund && fundPage) { %>
          <a
            href="/groups/<%= group.id %>/fund?pageId=<%= fundPage.id %>"
            class="secondary-button button-link"
          >
            基金画面を開く
          </a>
        <% } else { %>
          <span class="secondary-button button-link group-feature-disabled" aria-disabled="true">
            基金画面を開けません
          </span>
        <% } %>
      </section>

      <section class="panel group-feature-card group-payment-card">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">支払い</p>
            <h2>関連支払い・割り勘</h2>
          </div>
          <span>表示可能</span>
        </div>

        <p class="group-feature-description">
          各メンバーが個人の財布から支払ったグループ関連支出を、
          基金とは分けて集計します。
        </p>

        <% const paymentPage = ledgerPages.find(page => page.pageType === "GROUP_PAYMENT"); %>
        <p class="group-feature-page">
          初期ページ：
          <strong><%= paymentPage ? paymentPage.name : "未作成" %></strong>
        </p>
        <% if (paymentPage) { %>
          <a
            href="/groups/<%= group.id %>/payments?pageId=<%= paymentPage.id %>"
            class="secondary-button button-link"
          >
            関連支払い画面を開く
          </a>
        <% } else { %>
          <span class="secondary-button button-link group-feature-disabled" aria-disabled="true">
            関連支払い画面を開けません
          </span>
        <% } %>
      </section>
    </div>

    <section class="panel group-member-summary-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">所属</p>
          <h2>有効メンバー一覧</h2>
        </div>
        <span><%= activeMemberCount %> 人</span>
      </div>

      <% if (activeMembers.length === 0) { %>
        <p class="empty-state group-member-empty">有効なメンバーがいません。</p>
      <% } else { %>
        <ul class="group-member-list">
          <% activeMembers.forEach(member => { %>
            <li>
              <span class="group-member-identity">
                <strong><%= member.user.displayName %></strong>
                <small>ユーザーID：<%= member.user.loginId %></small>
              </span>
              <span class="group-member-badges">
                <% if (member.userId === currentUserId) { %>
                  <small class="current-user-badge">あなた</small>
                <% } %>
                <small class="role-badge <%= member.role === 'ADMIN' ? 'admin' : '' %>">
                  <%= member.role === "ADMIN" ? "管理者" : "メンバー" %>
                </small>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <% if (isAdmin) { %>
      <section class="panel group-admin-member-panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">管理者操作</p>
            <h2>メンバー追加・管理</h2>
          </div>
          <span>ADMIN限定</span>
        </div>

        <section class="group-admin-subsection" aria-labelledby="member-add-heading">
          <h3 id="member-add-heading">ユーザーIDでメンバーを追加</h3>
          <form action="/groups/<%= group.id %>/members" method="post" class="page-form group-member-form">
            <label>
              <span>ユーザーID（ログインID）</span>
              <input
                type="text"
                name="loginId"
                maxlength="50"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                required
              >
            </label>

            <p class="form-help">
              完全一致で検索します。ユーザー一覧や候補は表示しません。
              脱退済みユーザーを追加すると、MEMBERとして再有効化します。
            </p>

            <button type="submit" class="primary-button">メンバーを追加</button>
          </form>
        </section>

        <section class="group-admin-subsection" aria-labelledby="member-management-heading">
          <h3 id="member-management-heading">有効メンバーを管理</h3>

          <div class="group-admin-member-list">
            <% activeMembers.forEach(member => { %>
              <% const isOnlyActiveAdmin = member.role === "ADMIN" && activeAdminCount === 1; %>
              <article class="group-admin-member-row">
                <div class="group-admin-member-info">
                  <strong><%= member.user.displayName %></strong>
                  <small>ユーザーID：<%= member.user.loginId %></small>
                  <% if (member.userId === currentUserId) { %>
                    <small class="current-user-badge">あなた</small>
                  <% } %>
                </div>

                <form
                  action="/groups/<%= group.id %>/members/<%= member.userId %>/role"
                  method="post"
                  class="group-role-form"
                >
                  <label>
                    <span>グループ権限</span>
                    <select name="role" aria-label="<%= member.user.displayName %>さんのグループ権限">
                      <option
                        value="MEMBER"
                        <%= member.role === "MEMBER" ? "selected" : "" %>
                        <%= isOnlyActiveAdmin ? "disabled" : "" %>
                      >
                        メンバー
                      </option>
                      <option
                        value="ADMIN"
                        <%= member.role === "ADMIN" ? "selected" : "" %>
                      >
                        管理者
                      </option>
                    </select>
                  </label>
                  <button type="submit" class="small-button">権限を保存</button>
                </form>

                <form
                  action="/groups/<%= group.id %>/members/<%= member.userId %>/remove"
                  method="post"
                  class="group-remove-form"
                  onsubmit="return confirm('<%= member.user.displayName %>さんを脱退済みにしますか？過去の取引履歴は削除されません。');"
                >
                  <button
                    type="submit"
                    class="small-danger-button"
                    <%= member.userId === currentUserId || isOnlyActiveAdmin ? "disabled" : "" %>
                  >
                    脱退処理
                  </button>
                </form>

                <% if (member.userId === currentUserId) { %>
                  <p class="form-help group-member-action-note">
                    本人による自主脱退は現在実装していません。
                  </p>
                <% } else if (isOnlyActiveAdmin) { %>
                  <p class="form-help group-member-action-note">
                    唯一の有効な管理者は降格・脱退できません。
                  </p>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>
      </section>
    <% } %>
  </main>
</body>
</html>
