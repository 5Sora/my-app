<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= fund.name %> - <%= selectedPage.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/fund.css">
</head>
<body class="ledger-body fund-body">
  <header class="ledger-header">
    <div>
      <p class="eyebrow">グループ基金</p>
      <h1><%= fund.name %></h1>
      <p class="period-label">
        <strong><%= selectedPage.name %></strong>：
        <% if (selectedPage.startDate || selectedPage.endDate) { %>
          <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
          〜
          <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
        <% } else { %>
          全期間
        <% } %>
      </p>
    </div>

    <nav class="header-actions group-header-nav" aria-label="グループ画面ナビゲーション">
      <a href="/app" class="secondary-button button-link group-nav-item">自分の家計簿</a>
      <a href="/groups/<%= group.id %>" class="secondary-button button-link group-nav-item">概要</a>
      <a
        href="<%= buildGroupFundUrl(group.id, { pageId: selectedPage.id, contextState }) %>"
        class="secondary-button button-link group-nav-item is-active"
        data-fund-context-link
        aria-current="page"
      >
        基金
      </a>
      <span
        class="secondary-button button-link group-nav-item is-disabled"
        aria-disabled="true"
        title="関連支払いは未実装です"
      >
        関連支払い
      </span>
      <form action="/logout" method="post" class="group-nav-logout">
        <button type="submit" class="secondary-button group-nav-item">ログアウト</button>
      </form>
    </nav>
  </header>

  <% if (error || success) { %>
    <section class="flash-area" aria-live="polite">
      <% if (error) { %>
        <p class="error-message" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <section class="summary-grid" aria-label="基金収支サマリー">
    <article class="summary-card">
      <span>繰越金</span>
      <strong><%= summary.carryover.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card income-card">
      <span>基金収入</span>
      <strong><%= summary.incomeTotal.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card expense-card">
      <span>基金支出</span>
      <strong><%= summary.expenseTotal.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card balance-card">
      <span>基金残高</span>
      <strong><%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
    </article>
  </section>

  <main class="fund-layout<%= isContextOpen ? '' : ' is-context-closed' %>" data-fund-layout>
    <aside
      class="fund-context-column"
      id="fund-context-panel"
      aria-label="基金ページと有効メンバー"
      aria-hidden="<%= String(!isContextOpen) %>"
    >
      <section class="panel fund-page-panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">期間</p>
            <h2>表示ページ</h2>
          </div>
          <span><%= pages.length %> 件</span>
        </div>

        <nav class="page-list" aria-label="グループ基金ページ">
          <% pages.forEach(page => { %>
            <a
              href="<%= buildGroupFundUrl(group.id, { pageId: page.id, contextState }) %>"
              class="<%= page.id === selectedPage.id ? 'is-active' : '' %>"
              data-fund-context-link
              <% if (page.id === selectedPage.id) { %>aria-current="page"<% } %>
            >
              <span>
                <strong><%= page.name %></strong>
                <small>
                  <% if (page.startDate || page.endDate) { %>
                    <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "指定なし" %>
                    〜
                    <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "指定なし" %>
                  <% } else { %>
                    全期間
                  <% } %>
                </small>
              </span>
              <% if (page.isInitial) { %><small class="initial-badge">初期</small><% } %>
            </a>
          <% }) %>
        </nav>

        <p class="form-help fund-stage-note">
          LedgerPage管理はグループ管理者だけが行えます。
        </p>
      </section>

      <section class="panel fund-member-panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">閲覧専用</p>
            <h2>有効メンバー</h2>
          </div>
          <span><%= activeMembers.length %> 人</span>
        </div>

        <ul class="fund-member-list">
          <% activeMembers.forEach(member => { %>
            <li>
              <span>
                <strong><%= member.user.displayName %></strong>
                <% if (member.userId === currentUserId) { %><small>あなた</small><% } %>
              </span>
              <small><%= member.role === "ADMIN" ? "管理者" : "メンバー" %></small>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="panel fund-status-panel">
        <p class="eyebrow">基金状態</p>
        <dl class="group-definition-list">
          <div>
            <dt>基金名</dt>
            <dd><%= fund.name %></dd>
          </div>
          <div>
            <dt>状態</dt>
            <dd><%= fund.isActive ? "有効" : "無効" %></dd>
          </div>
          <div>
            <dt>自分の権限</dt>
            <dd><%= membership.role === "ADMIN" ? "グループ管理者" : "メンバー" %></dd>
          </div>
        </dl>
      </section>
    </aside>

    <aside class="fund-operation-rail" aria-label="LedgerPage操作">
      <button
        type="button"
        class="fund-context-toggle"
        data-fund-context-toggle
        aria-controls="fund-context-panel"
        aria-expanded="<%= String(isContextOpen) %>"
        aria-label="<%= isContextOpen ? '左領域を閉じる' : '左領域を開く' %>"
        title="<%= isContextOpen ? '左領域を閉じる' : '左領域を開く' %>"
      ><%= isContextOpen ? '←' : '→' %></button>
      <button
        type="button"
        data-open-dialog="fund-page-edit-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
      >⚙</button>
      <button
        type="button"
        data-open-dialog="fund-page-add-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
      >＋</button>
      <button
        type="submit"
        form="fund-delete-page-form"
        <%= !isAdmin || selectedPage.isInitial ? "disabled" : "" %>
        aria-label="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
        title="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
      >−</button>
    </aside>

    <aside class="panel fund-collapsed-column" aria-hidden="true">
      <p class="eyebrow">期間サマリー</p>
      <h2><%= selectedPage.name %></h2>
      <p class="fund-collapsed-balance">
        基金残高
        <strong><%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
      </p>
      <p class="form-help">左の右矢印から、LedgerPage一覧と有効メンバー一覧を開けます。</p>
    </aside>

    <section class="panel transaction-panel fund-transaction-panel">
      <div class="panel-heading fund-history-heading">
        <div>
          <p class="eyebrow">詳細</p>
          <h2>基金取引履歴</h2>
        </div>
        <div class="fund-history-actions">
          <span><%= transactions.length %> 件</span>
          <button
            type="button"
            class="fund-history-add"
            disabled
            aria-label="基金取引追加は第6-3で実装します"
            title="基金取引追加は第6-3で実装します"
          >＋</button>
        </div>
      </div>

      <% if (transactions.length === 0) { %>
        <p class="empty-state">この期間には、まだ基金取引がありません。</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="transaction-table fund-transaction-table">
            <thead>
              <tr>
                <th>取引日</th>
                <th>取引種別</th>
                <th>金額</th>
                <th>内容</th>
                <th>関係者</th>
                <th>カテゴリ</th>
                <th>分類元</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(transaction => { %>
                <% const isIncome = transaction.kind === "FUND_CONTRIBUTION" || transaction.kind === "FUND_INCOME"; %>
                <% const kindLabels = {
                  FUND_CONTRIBUTION: "基金拠出",
                  FUND_INCOME: "基金収入",
                  FUND_EXPENSE: "基金支出",
                  FUND_REFUND: "基金返金"
                }; %>
                <% const sourceLabels = { MANUAL: "手動", KEYWORD: "キーワード", AI: "AI" }; %>
                <tr>
                  <td><%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %></td>
                  <td>
                    <span class="kind-badge <%= isIncome ? 'income' : 'expense' %>">
                      <%= kindLabels[transaction.kind] %>
                    </span>
                  </td>
                  <td class="amount-cell <%= isIncome ? 'income-text' : 'expense-text' %>">
                    <%= isIncome ? "+" : "−" %><%= transaction.amount.toLocaleString("ja-JP") %> 円
                  </td>
                  <td><%= transaction.rawText %></td>
                  <td>
                    <% if (transaction.user) { %>
                      <%= transaction.user.displayName %>
                    <% } else if (transaction.kind === "FUND_INCOME") { %>
                      外部収入
                    <% } else if (transaction.kind === "FUND_REFUND") { %>
                      外部・関係者なし
                    <% } else { %>
                      関係者なし
                    <% } %>
                  </td>
                  <td><%= transaction.category %></td>
                  <td><%= sourceLabels[transaction.classificationSource] %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>


  <% if (isAdmin) { %>
    <dialog class="fund-page-dialog" id="fund-page-add-dialog" aria-labelledby="fund-page-add-title">
      <form action="/groups/<%= group.id %>/fund/pages" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-add-title">表示ページを追加</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate">
          </label>
        </div>

        <p class="form-help">日付を空欄にすると、その方向の期間を制限しません。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">ページを追加</button>
        </div>
      </form>
    </dialog>

    <dialog class="fund-page-dialog" id="fund-page-edit-dialog" aria-labelledby="fund-page-edit-title">
      <form action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-edit-title">選択中ページを編集</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" value="<%= selectedPage.name %>" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate" value="<%= selectedPageForm.startDate %>">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate" value="<%= selectedPageForm.endDate %>">
          </label>
        </div>

        <p class="form-help">初期ページも名前と期間は編集できます。初期ページの属性と削除不可状態は維持されます。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">変更を保存</button>
        </div>
      </form>
    </dialog>

    <form
      id="fund-delete-page-form"
      action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>/delete"
      method="post"
      class="fund-hidden-form"
      onsubmit="return confirm('選択中の表示ページを削除しますか？基金Transaction自体は削除されません。');"
    >
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
    </form>
  <% } %>

  <script>
    (() => {
      const layout = document.querySelector("[data-fund-layout]");
      const toggle = document.querySelector("[data-fund-context-toggle]");
      const context = document.getElementById("fund-context-panel");
      const stateInputs = document.querySelectorAll("[data-fund-context-state]");
      const stateLinks = document.querySelectorAll("[data-fund-context-link]");

      if (!layout || !toggle || !context) return;

      const setOpen = (isOpen) => {
        layout.classList.toggle("is-context-closed", !isOpen);
        toggle.textContent = isOpen ? "←" : "→";
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isOpen ? "左領域を閉じる" : "左領域を開く");
        toggle.setAttribute("title", isOpen ? "左領域を閉じる" : "左領域を開く");
        context.setAttribute("aria-hidden", String(!isOpen));

        const contextState = isOpen ? "open" : "closed";
        stateInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = contextState;
        });
        stateLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          if (isOpen) {
            url.searchParams.set("context", "open");
          } else {
            url.searchParams.delete("context");
          }
          link.href = `${url.pathname}${url.search}${url.hash}`;
        });
      };

      // 初回は閉状態。POST後やページ切替後は、直前の開閉状態を復元する。
      setOpen(toggle.getAttribute("aria-expanded") === "true");

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      document.querySelectorAll("[data-open-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialogId = button.getAttribute("data-open-dialog");
          const dialog = dialogId ? document.getElementById(dialogId) : null;
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      document.querySelectorAll("[data-close-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = button.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      document.querySelectorAll("dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
    })();
  </script>
</body>
</html>
