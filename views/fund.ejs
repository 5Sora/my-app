<!DOCTYPE html>
<%
  const fundVisualizationView = typeof fundVisualization !== "undefined" && fundVisualization
    ? fundVisualization
    : {
        incomeComposition: [],
        expenseComposition: [],
        totals: {
          internalContribution: 0,
          externalIncome: 0,
          income: 0,
          fundExpense: 0,
          refund: 0,
          expense: 0,
        },
        barScale: {
          incomePercent: 0,
          expensePercent: 0,
          internalSharePercent: 0,
          externalSharePercent: 0,
        },
      };
%>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>基金｜<%= group.name %>｜<%= selectedPage.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/fund.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <link rel="stylesheet" href="/css/ui-states.css">
  <link rel="stylesheet" href="/css/transaction-overlay.css">
  <script src="/js/ui-accessibility.js" defer></script>
</head>
<body class="ledger-body fund-body">
  <%- include("partials/app-header", {
    header: {
      mode: "group",
      groupId: group.id,
      active: "fund",
      fundHref: buildGroupFundUrl(group.id, { pageId: selectedPage.id, contextState })
    }
  }) %>

  <% if (error || success) { %>
    <section class="flash-area" role="region" aria-label="操作結果" aria-live="polite" aria-atomic="true">
      <% if (error) { %>
        <p class="error-message ui-state-message" data-ui-state="error" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message ui-state-message" data-ui-state="success" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <main class="ledger-shell fund-shell" aria-label="グループ基金">
    <section class="ledger-shell-top fund-shell-top" aria-label="基金の概要">
      <article class="panel fund-title-card" aria-labelledby="fund-ledger-title">
        <h2 class="ledger-context-title"><%= group.name %> の基金</h2>
        <h1 id="fund-ledger-title"><%= selectedPage.name %></h1>
        <p class="ledger-period-title<%= selectedPage.startDate || selectedPage.endDate ? '' : ' is-empty' %>">
          <% if (selectedPage.startDate || selectedPage.endDate) { %>
            <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
            〜
            <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
          <% } else { %>
            <span aria-hidden="true">&nbsp;</span>
          <% } %>
        </p>
      </article>

      <article class="panel fund-summary-card" aria-labelledby="fund-summary-title">
        <h2 id="fund-summary-title">サマリー</h2>
        <div class="fund-summary-rows">
          <div><span>繰越金</span><strong><%= summary.carryover.toLocaleString("ja-JP") %> 円</strong></div>
          <div><span>＋ 収入</span><strong class="income-text"><%= summary.incomeTotal.toLocaleString("ja-JP") %> 円</strong></div>
          <div><span>－ 支出</span><strong class="expense-text"><%= summary.expenseTotal.toLocaleString("ja-JP") %> 円</strong></div>
          <div class="fund-summary-total"><span>＝ 残高</span><strong><%= summary.balance.toLocaleString("ja-JP") %> 円</strong></div>
        </div>
      </article>

      <article
        class="panel fund-insight-card ledger-chart-panel"
        aria-labelledby="fund-composition-title"
        data-fund-income-chart
        data-fund-composition-chart
      >
        <div class="fund-insight-heading ledger-chart-heading">
          <h2 id="fund-composition-title">カテゴリ</h2>
          <button
            type="button"
            class="secondary-button fund-ai-analysis-button"
            data-ai-analysis-button
            data-endpoint="/api/ai/analyze-group-fund"
            data-group-id="<%= group.id %>"
            data-page-id="<%= selectedPage.id %>"
            data-page-name="<%= selectedPage.name %>"
            data-loading-message="選択中の基金ページを集計し、匿名化した拠出構造をAIへ分析依頼しています。"
          >AI分析</button>
        </div>

        <div class="fund-chart-toggle ledger-chart-controls" role="group" aria-label="基金円グラフの表示内容">
          <button
            type="button"
            class="fund-chart-toggle__button"
            data-fund-chart-mode="income"
            aria-pressed="false"
          >収入カテゴリ</button>
          <button
            type="button"
            class="fund-chart-toggle__button is-active"
            data-fund-chart-mode="expense"
            aria-pressed="true"
          >支出カテゴリ</button>
        </div>

        <div class="fund-income-chart ledger-chart-content" data-fund-chart-content <%= fundVisualizationView.totals.expense > 0 ? "" : "hidden" %>>
          <div class="fund-income-chart__visual">
            <svg
              class="fund-income-chart__pie"
              viewBox="0 0 100 100"
              role="img"
              aria-label="選択期間の基金支出構成。合計 <%= fundVisualizationView.totals.expense.toLocaleString("ja-JP") %> 円"
              data-fund-pie
            >
              <circle class="fund-income-chart__track" cx="50" cy="50" r="38" pathLength="100"></circle>
              <g data-fund-pie-segments></g>
            </svg>
            <div class="fund-income-chart__center" aria-hidden="true">
              <span data-fund-chart-center-label>支出</span>
              <strong data-fund-chart-center-amount><%= fundVisualizationView.totals.expense.toLocaleString("ja-JP") %></strong>
              <small>円</small>
            </div>
          </div>

          <div class="fund-income-chart__legend" aria-label="基金支出構成の凡例" data-fund-chart-legend>
            <ul>
              <% fundVisualizationView.expenseComposition.forEach(item => { %>
                <li>
                  <button
                    type="button"
                    class="fund-income-chart__legend-item"
                    style="--chart-color: <%= item.color %>"
                    data-fund-chart-item="<%= item.key %>"
                    aria-label="<%= item.label %>、<%= item.sourceTypeLabel %>、<%= item.amount.toLocaleString("ja-JP") %>円、<%= item.percentage %>パーセント"
                  >
                    <span class="fund-income-chart__swatch" aria-hidden="true"></span>
                    <span class="fund-income-chart__legend-name">
                      <strong><%= item.label %></strong>
                      <small><%= item.sourceTypeLabel %></small>
                    </span>
                    <span class="fund-income-chart__legend-value">
                      <strong><%= item.amount.toLocaleString("ja-JP") %> 円</strong>
                      <small><%= item.percentage.toFixed(1) %>%</small>
                    </span>
                  </button>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="fund-chart-empty ledger-chart-content" role="status" data-fund-chart-empty <%= fundVisualizationView.totals.expense > 0 ? "hidden" : "" %>>
          <strong data-fund-chart-empty-title>表示できる基金支出がありません</strong>
          <span data-fund-chart-empty-description>選択期間に基金支出または基金返金が登録されると、ここに構成を表示します。</span>
        </div>

        <div class="fund-income-chart__tooltip" role="tooltip" hidden data-fund-chart-tooltip></div>

        <script type="application/json" data-fund-income-chart-data data-fund-chart-data><%- JSON.stringify({
          income: fundVisualizationView.incomeComposition,
          expense: fundVisualizationView.expenseComposition,
          totals: {
            income: fundVisualizationView.totals.income,
            expense: fundVisualizationView.totals.expense,
          },
        }).replace(/</g, "\\u003c") %></script>
      </article>
    </section>

    <section class="ledger-shell-lower fund-layout<%= isContextOpen ? '' : ' is-context-closed' %>" data-fund-layout>
    <aside
      class="fund-context-column"
      id="fund-context-panel"
      aria-label="基金ページと所属メンバー"
      aria-hidden="<%= String(!isContextOpen) %>"
    >
      <section class="panel fund-page-panel ledger-context-panel">
        <div class="panel-heading compact">
          <h2>表示ページ</h2>
          <span><%= pages.length %> 件</span>
        </div>

        <nav class="page-list ledger-context-list" aria-label="グループ基金ページ">
          <% pages.forEach(page => { %>
            <a
              href="<%= buildGroupFundUrl(group.id, { pageId: page.id, contextState }) %>"
              class="<%= page.id === selectedPage.id ? 'is-active' : '' %>"
              data-fund-context-link
              <% if (page.id === selectedPage.id) { %>aria-current="page"<% } %>
            >
              <span>
                <strong><%= page.name %></strong>
              </span>
              <% if (page.isInitial) { %><small class="initial-badge">初期</small><% } %>
            </a>
          <% }) %>
        </nav>

        <p class="form-help fund-stage-note">
          LedgerPage管理はグループ管理者だけが行えます。
        </p>
      </section>

      <section class="panel fund-member-panel ledger-context-panel">
        <div class="panel-heading compact">
          <h2>所属メンバー</h2>
          <span><%= activeMembers.length %> 人</span>
        </div>

        <ul class="fund-member-list ledger-context-list">
          <% activeMembers.forEach(member => { %>
            <li><strong><%= member.user.displayName %></strong></li>
          <% }) %>
        </ul>
      </section>
    </aside>

    <aside class="fund-operation-rail" aria-label="LedgerPage操作">
      <button
        type="button"
        class="fund-context-toggle ledger-operation-button"
        data-fund-context-toggle
        aria-controls="fund-context-panel"
        aria-expanded="<%= String(isContextOpen) %>"
        aria-label="<%= isContextOpen ? '一覧を閉じる' : '一覧を開く' %>"
        title="<%= isContextOpen ? '一覧を閉じる' : '一覧を開く' %>"
      >
        <span class="ledger-operation-icon ledger-operation-icon--desktop" data-operation-desktop-icon aria-hidden="true"><%= isContextOpen ? '←' : '→' %></span>
        <span class="ledger-operation-icon ledger-operation-icon--mobile" data-operation-mobile-icon aria-hidden="true"><%= isContextOpen ? '↑' : '↓' %></span>
        <span class="ledger-operation-label" data-operation-label><%= isContextOpen ? '閉じる' : '開く' %></span>
      </button>
      <button
        class="ledger-operation-button"
        type="button"
        data-open-dialog="fund-page-edit-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
      ><span aria-hidden="true">⚙</span><span class="ledger-operation-label">編集</span></button>
      <button
        class="ledger-operation-button"
        type="button"
        data-open-dialog="fund-page-add-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
      ><span aria-hidden="true">＋</span><span class="ledger-operation-label">ページ追加</span></button>
      <button
        class="ledger-operation-button"
        type="submit"
        form="fund-delete-page-form"
        <%= !isAdmin || selectedPage.isInitial ? "disabled" : "" %>
        aria-label="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
        title="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
      ><span aria-hidden="true">−</span><span class="ledger-operation-label">ページ削除</span></button>
    </aside>

    <aside class="panel fund-collapsed-column">
      <div class="fund-bar-chart-heading">
        <h2>収入・支出</h2>
      </div>

      <% if (fundVisualizationView.totals.income > 0 || fundVisualizationView.totals.expense > 0) { %>
        <div
          class="fund-bar-chart"
          role="img"
          aria-label="基金収入 <%= fundVisualizationView.totals.income.toLocaleString("ja-JP") %> 円、基金支出 <%= fundVisualizationView.totals.expense.toLocaleString("ja-JP") %> 円"
        >
          <div class="fund-bar-chart__plot" aria-hidden="true">
            <section class="fund-bar-chart__column">
              <div class="fund-bar-chart__track">
                <div class="fund-bar-chart__income" style="height: <%= fundVisualizationView.barScale.incomePercent %>%">
                  <% if (fundVisualizationView.totals.internalContribution > 0) { %>
                    <span class="fund-bar-chart__internal" style="height: <%= fundVisualizationView.barScale.internalSharePercent %>%"></span>
                  <% } %>
                  <% if (fundVisualizationView.totals.externalIncome > 0) { %>
                    <span class="fund-bar-chart__external" style="height: <%= fundVisualizationView.barScale.externalSharePercent %>%"></span>
                  <% } %>
                </div>
              </div>
              <strong class="fund-bar-chart__category">収入</strong>
            </section>

            <section class="fund-bar-chart__column">
              <div class="fund-bar-chart__track">
                <div class="fund-bar-chart__expense" style="height: <%= fundVisualizationView.barScale.expensePercent %>%"></div>
              </div>
              <strong class="fund-bar-chart__category">支出</strong>
            </section>
          </div>
        </div>

        <dl class="fund-bar-chart__legend">
          <div><dt><span class="fund-bar-chart__key is-internal"></span>内部拠出</dt><dd><%= fundVisualizationView.totals.internalContribution.toLocaleString("ja-JP") %> 円</dd></div>
          <div><dt><span class="fund-bar-chart__key is-external"></span>外部収入</dt><dd><%= fundVisualizationView.totals.externalIncome.toLocaleString("ja-JP") %> 円</dd></div>
          <div><dt><span class="fund-bar-chart__key is-expense"></span>基金支出・返金</dt><dd><%= fundVisualizationView.totals.expense.toLocaleString("ja-JP") %> 円</dd></div>
        </dl>
      <% } else { %>
        <div class="fund-chart-empty is-compact" role="status">
          <strong>比較できる取引がありません</strong>
          <span>選択期間に収入または支出が登録されると棒グラフを表示します。</span>
        </div>
      <% } %>
    </aside>

    <section class="panel transaction-panel fund-transaction-panel">
      <% const kindLabels = {
        FUND_CONTRIBUTION: "基金拠出",
        FUND_INCOME: "基金収入",
        FUND_EXPENSE: "基金支出",
        FUND_REFUND: "基金返金"
      }; %>
      <% const sourceLabels = { MANUAL: "手動", KEYWORD: "キーワード", AI: "AI" }; %>
      <% const carryoverIsIncomeSide = summary.carryover >= 0; %>
      <% const balanceIsIncomeSide = summary.balance >= 0; %>
      <% const carryoverDateLabel = selectedPage.startDate
        ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP")
        : "はじめ"; %>
      <% const balanceDateLabel = selectedPage.endDate
        ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP")
        : "おわり"; %>
      <% const carryoverDateAriaLabel = selectedPage.startDate ? carryoverDateLabel : "選択期間の開始時点"; %>
      <% const balanceDateAriaLabel = selectedPage.endDate ? balanceDateLabel : "選択期間の終了時点"; %>

      <div class="panel-heading fund-history-heading">
        <h2>履歴詳細</h2>
        <div class="fund-history-actions">
          <span><%= transactions.length %> 件</span>
          <button
            type="button"
            class="fund-history-add"
            data-open-transaction-overlay="fund-transaction-overlay"
            <%= canCreateFundTransaction ? "" : "disabled" %>
            aria-label="<%= canCreateFundTransaction ? '基金取引を追加' : '無効な基金には取引を追加できません' %>"
            title="<%= canCreateFundTransaction ? '基金取引を追加' : '無効な基金には取引を追加できません' %>"
          >＋</button>
        </div>
      </div>

      <div class="fund-ledger" aria-label="基金収入と基金支出の取引台帳">
        <div class="fund-ledger-column-heading" role="row">
          <span role="columnheader">日付</span>
          <span role="columnheader">収入内容</span>
          <span role="columnheader">収入金額</span>
          <span role="columnheader">支出内容</span>
          <span role="columnheader">支出金額</span>
        </div>

        <section class="fund-ledger-section fund-ledger-carryover" aria-label="繰越金">
          <div class="fund-ledger-row fund-ledger-summary-row <%= carryoverIsIncomeSide ? 'is-income-row' : 'is-expense-row' %>">
            <time aria-label="<%= carryoverDateAriaLabel %>"><%= carryoverDateLabel %></time>
            <% if (carryoverIsIncomeSide) { %>
              <div class="fund-ledger-content-cell"><strong>繰越金</strong></div>
              <strong class="fund-ledger-amount income-text">+<%= summary.carryover.toLocaleString("ja-JP") %> 円</strong>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
            <% } else { %>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-content-cell"><strong>繰越金</strong></div>
              <strong class="fund-ledger-amount expense-text">−<%= Math.abs(summary.carryover).toLocaleString("ja-JP") %> 円</strong>
            <% } %>
          </div>
        </section>

        <section class="fund-ledger-section fund-ledger-transactions" aria-label="取引詳細">
          <div class="fund-ledger-scroll" tabindex="0" aria-label="基金取引詳細。上下にスクロールできます">
            <% if (transactions.length === 0) { %>
              <p class="empty-state fund-ledger-empty-state">この期間には、まだ基金取引がありません。</p>
            <% } else { %>
              <% transactions.forEach(transaction => { %>
                <% const isIncomeTransaction = transaction.kind === "FUND_CONTRIBUTION" || transaction.kind === "FUND_INCOME"; %>
                <% const relationLabel = transaction.user
                  ? transaction.user.displayName
                  : transaction.kind === "FUND_INCOME"
                    ? "外部収入"
                    : transaction.kind === "FUND_REFUND"
                      ? "外部・関係者なし"
                      : "関係者なし"; %>
                <article class="fund-ledger-row fund-ledger-transaction-row <%= isIncomeTransaction ? 'is-income-row' : 'is-expense-row' %>">
                  <time
                    datetime="<%= new Date(transaction.transactionDate).toISOString().slice(0, 10) %>"
                    title="<%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %>"
                  >
                    <%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %>
                  </time>

                  <% if (isIncomeTransaction) { %>
                    <% const transactionMeta = `${kindLabels[transaction.kind]}・${relationLabel}・${transaction.category}・${sourceLabels[transaction.classificationSource]}`; %>
                    <div class="fund-ledger-content-cell">
                      <strong class="fund-ledger-primary-text" data-ledger-tooltip="<%= transaction.rawText %>" aria-label="<%= transaction.rawText %>"><%= transaction.rawText %></strong>
                      <small class="fund-ledger-meta" data-ledger-tooltip="<%= transactionMeta %>" aria-label="<%= transactionMeta %>"><%= transactionMeta %></small>
                    </div>
                    <strong class="fund-ledger-amount income-text">+<%= transaction.amount.toLocaleString("ja-JP") %> 円</strong>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                  <% } else { %>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <% const transactionMeta = `${kindLabels[transaction.kind]}・${relationLabel}・${transaction.category}・${sourceLabels[transaction.classificationSource]}`; %>
                    <div class="fund-ledger-content-cell">
                      <strong class="fund-ledger-primary-text" data-ledger-tooltip="<%= transaction.rawText %>" aria-label="<%= transaction.rawText %>"><%= transaction.rawText %></strong>
                      <small class="fund-ledger-meta" data-ledger-tooltip="<%= transactionMeta %>" aria-label="<%= transactionMeta %>"><%= transactionMeta %></small>
                    </div>
                    <strong class="fund-ledger-amount expense-text">−<%= transaction.amount.toLocaleString("ja-JP") %> 円</strong>
                  <% } %>
                </article>
              <% }) %>
            <% } %>
          </div>
        </section>

        <section class="fund-ledger-section fund-ledger-balance" aria-label="残高">
          <div class="fund-ledger-row fund-ledger-summary-row <%= balanceIsIncomeSide ? 'is-income-row' : 'is-expense-row' %>">
            <time aria-label="<%= balanceDateAriaLabel %>"><%= balanceDateLabel %></time>
            <% if (balanceIsIncomeSide) { %>
              <div class="fund-ledger-content-cell"><strong>残高</strong></div>
              <strong class="fund-ledger-amount income-text">+<%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
            <% } else { %>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-content-cell"><strong>残高</strong></div>
              <strong class="fund-ledger-amount expense-text">−<%= Math.abs(summary.balance).toLocaleString("ja-JP") %> 円</strong>
            <% } %>
          </div>
        </section>
      </div>
    </section>
    </section>
  </main>


  <% if (isAdmin) { %>
    <dialog class="fund-page-dialog" aria-modal="true" id="fund-page-add-dialog" aria-labelledby="fund-page-add-title">
      <form action="/groups/<%= group.id %>/fund/pages" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-add-title">表示ページを追加</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate">
          </label>
        </div>

        <p class="form-help">日付を空欄にすると、その方向の期間を制限しません。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">ページを追加</button>
        </div>
      </form>
    </dialog>

    <dialog class="fund-page-dialog" aria-modal="true" id="fund-page-edit-dialog" aria-labelledby="fund-page-edit-title">
      <form action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-edit-title">選択中ページを編集</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" value="<%= selectedPage.name %>" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate" value="<%= selectedPageForm.startDate %>">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate" value="<%= selectedPageForm.endDate %>">
          </label>
        </div>

        <p class="form-help">初期ページも名前と期間は編集できます。初期ページの属性と削除不可状態は維持されます。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">変更を保存</button>
        </div>
      </form>
    </dialog>

    <form
      id="fund-delete-page-form"
      action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>/delete"
      method="post"
      class="fund-hidden-form"
      onsubmit="return confirm('選択中の表示ページを削除しますか？基金Transaction自体は削除されません。');"
    >
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
    </form>
  <% } %>

  <%- include("partials/transaction-add-overlay", {
    overlay: {
      id: "fund-transaction-overlay",
      mode: "FUND",
      eyebrow: "グループ基金",
      title: "基金取引を追加",
      action: `/groups/${group.id}/fund/transactions/expense`,
      routes: {
        income: `/groups/${group.id}/fund/transactions/income`,
        expense: `/groups/${group.id}/fund/transactions/expense`,
        contribution: `/groups/${group.id}/fund/transactions/contribution`,
        refund: `/groups/${group.id}/fund/transactions/refund`
      },
      groupId: group.id,
      today,
      placeholder: "例：昨日外部団体から寄付5000円を受け取った",
      note: "基金収入・基金支出はAI推定できます。基金拠出・基金返金は種類と対象者を手動で確認します。",
      submitLabel: "取引を登録",
      categories: { income: fundIncomeCategories, expense: fundExpenseCategories },
      activeMembers,
      refundRecipients,
      currentUserId,
      hiddenFields: [
        { name: "currentPageId", value: selectedPage.id },
        { name: "contextState", value: contextState, contextHook: "data-fund-context-state" }
      ]
    }
  }) %>


  <%- include("partials/ai-analysis-dialog", {
    analysisDialog: {
      id: "group-fund-ai-analysis-dialog",
      eyebrow: "基金集計",
      title: "基金分析",
      pageName: selectedPage.name
    }
  }) %>

  <script>
    (() => {
      const layout = document.querySelector("[data-fund-layout]");
      const toggle = document.querySelector("[data-fund-context-toggle]");
      const context = document.getElementById("fund-context-panel");
      const collapsedSummary = document.querySelector(".fund-collapsed-column");
      const stateInputs = document.querySelectorAll("[data-fund-context-state]");
      const stateLinks = document.querySelectorAll("[data-fund-context-link]");

      if (!layout || !toggle || !context) return;

      const setOpen = (isOpen) => {
        layout.classList.toggle("is-context-closed", !isOpen);
        const desktopIcon = toggle.querySelector("[data-operation-desktop-icon]");
        const mobileIcon = toggle.querySelector("[data-operation-mobile-icon]");
        const label = toggle.querySelector("[data-operation-label]");
        if (desktopIcon instanceof HTMLElement) desktopIcon.textContent = isOpen ? "←" : "→";
        if (mobileIcon instanceof HTMLElement) mobileIcon.textContent = isOpen ? "↑" : "↓";
        if (label instanceof HTMLElement) label.textContent = isOpen ? "閉じる" : "開く";
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isOpen ? "一覧を閉じる" : "一覧を開く");
        toggle.setAttribute("title", isOpen ? "一覧を閉じる" : "一覧を開く");
        context.setAttribute("aria-hidden", String(!isOpen));
        collapsedSummary?.setAttribute("aria-hidden", String(isOpen));
        if (window.matchMedia("(max-width: 820px)").matches) {
          collapsedSummary?.setAttribute("aria-hidden", "false");
        }

        const contextState = isOpen ? "open" : "closed";
        stateInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = contextState;
        });
        stateLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          if (isOpen) {
            url.searchParams.set("context", "open");
          } else {
            url.searchParams.delete("context");
          }
          link.href = `${url.pathname}${url.search}${url.hash}`;
        });
      };

      // 初回は閉状態。POST後やページ切替後は、直前の開閉状態を復元する。
      setOpen(toggle.getAttribute("aria-expanded") === "true");

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      // 取引詳細の縦スクロールバー幅を、見出し・繰越金・残高へ同期する。
      const fundLedger = document.querySelector(".fund-ledger");
      const fundLedgerScroll = document.querySelector(".fund-ledger-scroll");
      const syncFundLedgerScrollbar = () => {
        if (!(fundLedger instanceof HTMLElement) || !(fundLedgerScroll instanceof HTMLElement)) return;
        const scrollbarWidth = Math.max(0, fundLedgerScroll.offsetWidth - fundLedgerScroll.clientWidth);
        fundLedger.style.setProperty("--fund-ledger-scrollbar-width", `${scrollbarWidth}px`);
      };

      requestAnimationFrame(syncFundLedgerScrollbar);
      window.addEventListener("resize", syncFundLedgerScrollbar);
      if ("ResizeObserver" in window && fundLedgerScroll instanceof HTMLElement) {
        const ledgerResizeObserver = new ResizeObserver(syncFundLedgerScrollbar);
        ledgerResizeObserver.observe(fundLedgerScroll);
      }

      // 省略された取引内容は、スクロール領域に切られない独自ツールチップで全文表示する。
      const ledgerTooltip = document.createElement("div");
      ledgerTooltip.className = "fund-ledger-tooltip";
      ledgerTooltip.setAttribute("role", "tooltip");
      ledgerTooltip.hidden = true;
      document.body.append(ledgerTooltip);

      let activeTooltipTarget = null;

      const hideLedgerTooltip = () => {
        ledgerTooltip.hidden = true;
        ledgerTooltip.textContent = "";
        activeTooltipTarget = null;
      };

      const showLedgerTooltip = (target) => {
        if (!(target instanceof HTMLElement)) return;
        const fullText = target.dataset.ledgerTooltip;
        if (!fullText || target.scrollWidth <= target.clientWidth) {
          hideLedgerTooltip();
          return;
        }

        ledgerTooltip.textContent = fullText;
        ledgerTooltip.hidden = false;
        activeTooltipTarget = target;

        const targetRect = target.getBoundingClientRect();
        const tooltipRect = ledgerTooltip.getBoundingClientRect();
        const viewportPadding = 12;
        const gap = 8;

        let left = targetRect.left;
        left = Math.min(left, window.innerWidth - tooltipRect.width - viewportPadding);
        left = Math.max(viewportPadding, left);

        let top = targetRect.bottom + gap;
        if (top + tooltipRect.height > window.innerHeight - viewportPadding) {
          top = Math.max(viewportPadding, targetRect.top - tooltipRect.height - gap);
        }

        ledgerTooltip.style.left = `${left}px`;
        ledgerTooltip.style.top = `${top}px`;
      };

      document.querySelectorAll("[data-ledger-tooltip]").forEach((target) => {
        target.addEventListener("mouseenter", () => showLedgerTooltip(target));
        target.addEventListener("mouseleave", hideLedgerTooltip);
      });

      fundLedgerScroll?.addEventListener("scroll", hideLedgerTooltip, { passive: true });
      window.addEventListener("resize", hideLedgerTooltip);
      window.addEventListener("scroll", hideLedgerTooltip, { passive: true, capture: true });

      document.querySelectorAll("[data-open-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialogId = button.getAttribute("data-open-dialog");
          const dialog = dialogId ? document.getElementById(dialogId) : null;
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      document.querySelectorAll("[data-switch-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const currentDialog = button.closest("dialog");
          const nextDialogId = button.getAttribute("data-switch-dialog");
          const nextDialog = nextDialogId ? document.getElementById(nextDialogId) : null;

          if (currentDialog instanceof HTMLDialogElement) currentDialog.close();
          if (nextDialog instanceof HTMLDialogElement) nextDialog.showModal();
        });
      });

      document.querySelectorAll("[data-close-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = button.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      document.querySelectorAll("dialog.fund-page-dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });

      const statusLabels = { EXPLICIT: "入力に明記", INFERRED: "AI・規則で推定", DEFAULTED: "画面の既定値", MISSING: "要入力" };
      document.querySelectorAll("[data-ai-classification-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;
        const button = form.querySelector("[data-ai-classify-button]");
        const rawText = form.elements.namedItem("rawText");
        const amount = form.elements.namedItem("amount");
        const date = form.elements.namedItem("transactionDate");
        const category = form.elements.namedItem("category");
        const token = form.querySelector("[data-ai-suggestion-token]");
        const panel = form.querySelector("[data-ai-suggestion-panel]");
        const message = form.querySelector("[data-ai-message]");
        const statuses = form.querySelector("[data-ai-field-status]");
        const warnings = form.querySelector("[data-ai-warnings]");
        button?.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement) || !(rawText instanceof HTMLTextAreaElement)) return;
          const text = rawText.value.trim();
          if (!text) { rawText.setCustomValidity("AIで推定する内容を入力してください。"); rawText.reportValidity(); rawText.setCustomValidity(""); return; }
          button.disabled = true; button.textContent = "推定中…"; form.setAttribute("aria-busy", "true");
          if (panel instanceof HTMLElement) panel.hidden = false;
          if (message instanceof HTMLElement) message.textContent = "AIで候補を作成しています。";
          try {
            const response = await fetch("/api/ai/classify-transaction", {
              method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, credentials: "same-origin",
              body: JSON.stringify({ target: form.dataset.aiTarget, groupId: Number(form.dataset.aiGroupId), rawText: text }),
            });
            const payload = await response.json().catch(() => null);
            if (!payload?.suggestion) throw new Error(payload?.message || "AI候補を取得できませんでした。");
            const suggestion = payload.suggestion;
            if (amount instanceof HTMLInputElement && suggestion.amount !== null) amount.value = String(suggestion.amount);
            if (date instanceof HTMLInputElement) date.value = suggestion.transactionDate || payload.referenceDate || date.value;
            if (category instanceof HTMLSelectElement) category.value = suggestion.category || "";
            if (payload.source === "AI" && suggestion.summary) rawText.value = suggestion.summary;
            if (token instanceof HTMLInputElement) token.value = payload.suggestionToken || "";
            if (message instanceof HTMLElement) { message.textContent = payload.message || "候補を表示しました。"; message.dataset.source = payload.source || ""; }
            if (statuses instanceof HTMLElement) {
              statuses.replaceChildren();
              [["種類", suggestion.fieldStatus?.transactionType], ["金額", suggestion.fieldStatus?.amount], ["取引日", suggestion.transactionDate ? suggestion.fieldStatus?.transactionDate : "DEFAULTED"], ["カテゴリ", suggestion.fieldStatus?.category]].forEach(([label, status]) => {
                const dt = document.createElement("dt"); dt.textContent = label;
                const dd = document.createElement("dd"); dd.textContent = statusLabels[status] || "要確認"; dd.dataset.status = status || "";
                statuses.append(dt, dd);
              });
            }
            if (warnings instanceof HTMLUListElement) {
              warnings.replaceChildren();
              (Array.isArray(suggestion.warnings) ? suggestion.warnings : []).forEach((value) => { const li = document.createElement("li"); li.textContent = String(value); warnings.append(li); });
              warnings.hidden = warnings.children.length === 0;
            }
          } catch (error) {
            if (message instanceof HTMLElement) { message.textContent = error instanceof Error ? error.message : "AI候補を取得できませんでした。"; message.dataset.source = "ERROR"; }
          } finally { button.disabled = false; button.textContent = "AIで推定"; form.removeAttribute("aria-busy"); }
        });
      });

      // DB更新フォームは最初の有効なsubmitで即時ロックし、連打による重複登録を防ぐ。
      document.querySelectorAll("form[method='post']").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (event.defaultPrevented) return;

          if (form.dataset.submitting === "true") {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          form.dataset.submitting = "true";
          form.setAttribute("aria-busy", "true");

          form.querySelectorAll("button[type='submit'], input[type='submit']").forEach((control) => {
            if (control instanceof HTMLButtonElement) {
              control.dataset.originalText = control.textContent ?? "";
              control.textContent = "処理中…";
              control.disabled = true;
            } else if (control instanceof HTMLInputElement) {
              control.dataset.originalValue = control.value;
              control.value = "処理中…";
              control.disabled = true;
            }
          });
        });
      });
    })();
  </script>
  <script src="/js/fund-charts.js" defer></script>
  <script src="/js/transaction-overlay.js" defer></script>
  <script src="/js/ai-analysis-dialog.js" defer></script>
</body>
</html>
