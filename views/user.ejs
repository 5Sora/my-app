<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= user.name %> の家計簿</title>
</head>
<body>
  <p><a href="/">トップへ戻る</a></p>

  <h1><%= user.name %> の家計簿</h1>

  <h2>個人支出入力</h2>
  <form action="/users/<%= user.id %>/transactions" method="post">
    <input
      type="text"
      name="rawText"
      placeholder="例: コンビニで800円"
      required
    >
    <button type="submit">登録</button>
  </form>

  <h2>集計</h2>
  <ul>
    <li>個人支出合計: <%= personalTotal %> 円</li>
    <li>グループ関連支出合計: <%= groupTotal %> 円</li>
    <li>全支出合計: <%= total %> 円</li>
  </ul>

  <h2>支出一覧</h2>
  <ul>
    <% transactions.forEach(tx => { %>
      <li>
        <%= tx.amount %>円 /
        <%= tx.category %> /
        <%= tx.rawText %> /
        <% if (tx.group) { %>
          グループ:
          <a href="/groups/<%= tx.group.id %>"><%= tx.group.name %></a>
        <% } else { %>
          個人支出
        <% } %>
      </li>
    <% }) %>
  </ul>
</body>
</html>