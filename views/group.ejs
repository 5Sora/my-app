<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> - グループ概要</title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
</head>
<body class="ledger-body">
  <header class="ledger-header">
    <div>
      <p class="eyebrow">グループ概要</p>
      <h1><%= group.name %></h1>
      <p class="period-label">
        あなたの権限：<%= membership.role === "ADMIN" ? "グループ管理者" : "メンバー" %>
      </p>
    </div>

    <nav class="header-actions group-header-nav" aria-label="グループ画面ナビゲーション">
      <a href="/app" class="secondary-button button-link group-nav-item">自分の家計簿</a>
      <a
        href="/groups/<%= group.id %>"
        class="secondary-button button-link group-nav-item is-active"
        aria-current="page"
      >
        概要
      </a>
      <span
        class="secondary-button button-link group-nav-item is-disabled"
        aria-disabled="true"
        title="グループ基金は未実装です"
      >
        基金
      </span>
      <span
        class="secondary-button button-link group-nav-item is-disabled"
        aria-disabled="true"
        title="関連支払いは未実装です"
      >
        関連支払い
      </span>
      <form action="/logout" method="post" class="group-nav-logout">
        <button type="submit" class="secondary-button group-nav-item">ログアウト</button>
      </form>
    </nav>
  </header>

  <% if (error || success) { %>
    <section class="flash-area" aria-live="polite">
      <% if (error) { %>
        <p class="error-message" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <main class="group-overview-layout">
    <section class="panel">
      <p class="eyebrow">基金</p>
      <h2>グループ基金</h2>

      <% if (fund) { %>
        <dl class="group-definition-list">
          <div>
            <dt>基金名</dt>
            <dd><%= fund.name %></dd>
          </div>
          <div>
            <dt>状態</dt>
            <dd><%= fund.isActive ? "有効" : "無効" %></dd>
          </div>
        </dl>
      <% } else { %>
        <p class="error-message" role="alert">このグループの基金が見つかりません。</p>
      <% } %>
    </section>

    <section class="panel group-pages-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">会計ページ</p>
          <h2>初期ページ</h2>
        </div>
        <span><%= ledgerPages.length %> 件</span>
      </div>

      <% if (ledgerPages.length === 0) { %>
        <p class="empty-state compact-empty-state">グループ用ページがありません。</p>
      <% } else { %>
        <ul class="group-page-list">
          <% ledgerPages.forEach(page => { %>
            <li>
              <div>
                <strong>
                  <%= page.pageType === "GROUP_FUND" ? "基金ページ" : "グループ支払いページ" %>
                </strong>
                <span><%= page.name %></span>
              </div>
              <div class="group-page-meta">
                <% if (page.isInitial) { %><small>初期</small><% } %>
                <small>
                  <% if (page.startDate || page.endDate) { %>
                    <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "指定なし" %>
                    〜
                    <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "指定なし" %>
                  <% } else { %>
                    全期間
                  <% } %>
                </small>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <p class="form-help">
        基金取引、メンバー追加、支払い管理は後続段階で実装します。
      </p>
    </section>
  </main>
</body>
</html>
