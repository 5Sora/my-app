<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>概要｜<%= group.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <link rel="stylesheet" href="/css/ui-states.css">
  <script src="/js/ui-accessibility.js" defer></script>
  <script src="/js/group-overview.js" defer></script>
</head>
<body class="ledger-body group-overview-body">
  <%- include("partials/app-header", {
    header: {
      mode: "group",
      groupId: group.id,
      active: "overview"
    }
  }) %>

  <% if (error || success) { %>
    <section class="flash-area" role="region" aria-label="操作結果" aria-live="polite" aria-atomic="true">
      <% if (error) { %>
        <p class="error-message ui-state-message" data-ui-state="error" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message ui-state-message" data-ui-state="success" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <% const fundPages = ledgerPages.filter(page => page.pageType === "GROUP_FUND"); %>
  <% const paymentPages = ledgerPages.filter(page => page.pageType === "GROUP_PAYMENT"); %>

  <main class="group-overview-shell">
    <section class="group-overview-top" aria-label="グループ情報と台帳ページ">
      <article class="panel group-overview-info-panel">
        <div class="panel-heading compact group-overview-panel-heading">
          <h2>グループ情報</h2>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="group-heading-action"
              data-open-dialog="group-name-dialog"
              aria-label="グループ名を変更"
              title="グループ名を変更"
            >編集</button>
          <% } else { %>
            <span><%= group.isActive ? "有効" : "無効" %></span>
          <% } %>
        </div>

        <dl class="group-definition-list group-overview-definition-list">
          <div>
            <dt>グループ名</dt>
            <dd><%= group.name %></dd>
          </div>
          <div>
            <dt>自分の権限</dt>
            <dd><%= membership.role === "ADMIN" ? "グループ管理者" : "メンバー" %></dd>
          </div>
          <div>
            <dt>グループ状態</dt>
            <dd><%= group.isActive ? "有効" : "無効" %></dd>
          </div>
        </dl>
      </article>

      <article class="panel group-overview-pages-panel group-fund-pages-panel ledger-context-panel">
        <div class="panel-heading compact group-overview-panel-heading">
          <h2>基金ページ</h2>
          <span><%= fundPages.length %> 件</span>
        </div>

        <% if (!fund) { %>
          <p class="error-message ui-state-message" data-ui-state="error" role="alert">このグループの基金が見つかりません。</p>
        <% } else if (fundPages.length === 0) { %>
          <p class="empty-state group-overview-page-empty">基金ページがありません。</p>
        <% } else { %>
          <nav class="group-overview-page-list ledger-context-list" aria-label="基金ページ">
            <% fundPages.forEach(page => { %>
              <a href="/groups/<%= group.id %>/fund?pageId=<%= page.id %>">
                <span>
                  <strong><%= page.name %></strong>
                  <small>
                    <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "開始指定なし" %>
                    ～
                    <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "終了指定なし" %>
                  </small>
                </span>
                <% if (page.isInitial) { %><small class="group-page-badge">初期</small><% } %>
              </a>
            <% }) %>
          </nav>
        <% } %>
      </article>

      <article class="panel group-overview-pages-panel group-payment-pages-panel ledger-context-panel">
        <div class="panel-heading compact group-overview-panel-heading">
          <h2>割り勘ページ</h2>
          <span><%= paymentPages.length %> 件</span>
        </div>

        <% if (paymentPages.length === 0) { %>
          <p class="empty-state group-overview-page-empty">割り勘ページがありません。</p>
        <% } else { %>
          <nav class="group-overview-page-list ledger-context-list" aria-label="割り勘ページ">
            <% paymentPages.forEach(page => { %>
              <a href="/groups/<%= group.id %>/payments?pageId=<%= page.id %>">
                <span>
                  <strong><%= page.name %></strong>
                  <small>
                    <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "開始指定なし" %>
                    ～
                    <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "終了指定なし" %>
                  </small>
                </span>
                <% if (page.isInitial) { %><small class="group-page-badge">初期</small><% } %>
              </a>
            <% }) %>
          </nav>
        <% } %>
      </article>
    </section>

    <section class="panel group-members-panel" aria-labelledby="group-members-heading">
      <div class="panel-heading group-members-heading">
        <h2 id="group-members-heading">所属メンバー</h2>
        <div class="group-members-heading-actions">
          <span><%= activeMemberCount %> 人（管理者 <%= activeAdminCount %> 人）</span>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="group-member-add-button"
              data-open-dialog="group-member-add-dialog"
              aria-label="メンバーを追加"
              title="メンバーを追加"
            >＋</button>
          <% } %>
        </div>
      </div>

      <% if (activeMembers.length === 0) { %>
        <p class="empty-state group-member-empty">有効なメンバーがいません。</p>
      <% } else { %>
        <div class="group-member-list" role="list">
          <% activeMembers.forEach(member => { %>
            <% const isOnlyActiveAdmin = member.role === "ADMIN" && activeAdminCount === 1; %>
            <article class="group-member-row" role="listitem">
              <div class="group-member-identity">
                <strong><%= member.user.displayName %></strong>
                <small>ユーザーID：<%= member.user.loginId %></small>
              </div>

              <div class="group-member-badges">
                <% if (member.userId === currentUserId) { %>
                  <small class="current-user-badge">あなた</small>
                <% } %>
                <small class="role-badge <%= member.role === 'ADMIN' ? 'admin' : '' %>">
                  <%= member.role === "ADMIN" ? "管理者" : "メンバー" %>
                </small>
              </div>

              <% if (isAdmin) { %>
                <div class="group-member-admin-actions">
                  <form
                    action="/groups/<%= group.id %>/members/<%= member.userId %>/role"
                    method="post"
                    class="group-role-form"
                  >
                    <label>
                      <span>権限</span>
                      <select name="role" aria-label="<%= member.user.displayName %>さんのグループ権限">
                        <option
                          value="MEMBER"
                          <%= member.role === "MEMBER" ? "selected" : "" %>
                          <%= isOnlyActiveAdmin ? "disabled" : "" %>
                        >メンバー</option>
                        <option
                          value="ADMIN"
                          <%= member.role === "ADMIN" ? "selected" : "" %>
                        >管理者</option>
                      </select>
                    </label>
                    <button type="submit" class="small-button">保存</button>
                  </form>

                  <form
                    action="/groups/<%= group.id %>/members/<%= member.userId %>/remove"
                    method="post"
                    class="group-remove-form"
                    onsubmit="return confirm('<%= member.user.displayName %>さんを脱退済みにしますか？過去の取引履歴は削除されません。');"
                  >
                    <button
                      type="submit"
                      class="small-danger-button"
                      <%= member.userId === currentUserId || isOnlyActiveAdmin ? "disabled" : "" %>
                    >脱退</button>
                  </form>
                </div>

                <% if (member.userId === currentUserId) { %>
                  <p class="form-help group-member-action-note">本人による自主脱退は現在実装していません。</p>
                <% } else if (isOnlyActiveAdmin) { %>
                  <p class="form-help group-member-action-note">唯一の有効な管理者は降格・脱退できません。</p>
                <% } %>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <% if (isAdmin) { %>
    <dialog id="group-name-dialog" class="group-dialog" aria-modal="true" aria-labelledby="group-name-dialog-title">
      <form action="/groups/<%= group.id %>/name" method="post" class="group-dialog-form">
        <header class="group-dialog-heading">
          <div>
            <p class="eyebrow">グループ情報</p>
            <h2 id="group-name-dialog-title">グループ名を変更</h2>
          </div>
          <button type="button" class="group-dialog-close" data-close-dialog aria-label="閉じる">×</button>
        </header>
        <label>
          <span>グループ名</span>
          <input type="text" name="name" value="<%= group.name %>" maxlength="100" required data-dialog-initial-focus>
        </label>
        <p class="form-help">前後の空白は保存時に取り除きます。同名のグループも使用できます。</p>
        <footer class="group-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">グループ名を保存</button>
        </footer>
      </form>
    </dialog>

    <dialog id="group-member-add-dialog" class="group-dialog" aria-modal="true" aria-labelledby="group-member-add-dialog-title">
      <form action="/groups/<%= group.id %>/members" method="post" class="group-dialog-form">
        <header class="group-dialog-heading">
          <div>
            <p class="eyebrow">メンバー</p>
            <h2 id="group-member-add-dialog-title">メンバーを追加</h2>
          </div>
          <button type="button" class="group-dialog-close" data-close-dialog aria-label="閉じる">×</button>
        </header>
        <label>
          <span>ユーザーID（ログインID）</span>
          <input
            type="text"
            name="loginId"
            maxlength="50"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
            data-dialog-initial-focus
          >
        </label>
        <p class="form-help">完全一致で検索します。脱退済みユーザーを追加すると、MEMBERとして再有効化します。</p>
        <footer class="group-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">メンバーを追加</button>
        </footer>
      </form>
    </dialog>
  <% } %>
</body>
</html>
