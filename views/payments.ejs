<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> - 関連支払い - <%= selectedPage.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/payments.css">
</head>
<body class="ledger-body payments-body<%= isCalculationMode ? ' is-calculation-mode' : '' %>" data-calculation-mode="<%= String(isCalculationMode) %>">
  <header class="ledger-header">
    <div>
      <p class="eyebrow">グループ関連支払い</p>
      <h1><%= group.name %></h1>
      <p class="period-label">
        <strong><%= selectedPage.name %></strong>：
        <% if (selectedPage.startDate || selectedPage.endDate) { %>
          <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
          〜
          <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
        <% } else { %>
          全期間
        <% } %>
      </p>
    </div>

    <nav class="header-actions group-header-nav" aria-label="グループ画面ナビゲーション">
      <a href="/app" class="secondary-button button-link group-nav-item">自分の家計簿</a>
      <a href="/groups/<%= group.id %>" class="secondary-button button-link group-nav-item">概要</a>
      <a href="/groups/<%= group.id %>/fund" class="secondary-button button-link group-nav-item">基金</a>
      <a
        href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState }) %>"
        class="secondary-button button-link group-nav-item is-active"
        data-payment-context-link
        aria-current="page"
      >
        関連支払い
      </a>
      <form action="/logout" method="post" class="group-nav-logout">
        <button type="submit" class="secondary-button group-nav-item">ログアウト</button>
      </form>
    </nav>
  </header>

  <% if (error || success) { %>
    <section class="flash-area" aria-live="polite">
      <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>
      <% if (success) { %><p class="success-message" role="status"><%= success %></p><% } %>
    </section>
  <% } %>

  <main class="payments-layout">
    <section class="payments-main-column" aria-label="関連支払いの操作と履歴">
      <section class="panel payments-top-area">
        <div class="payments-title-area">
          <p class="eyebrow">表示対象</p>
          <h2><%= selectedPage.name %>の関連支払い</h2>
          <dl class="payments-page-summary">
            <div>
              <dt>対象期間</dt>
              <dd>
                <% if (selectedPage.startDate || selectedPage.endDate) { %>
                  <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "指定なし" %>
                  〜
                  <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "指定なし" %>
                <% } else { %>
                  全期間
                <% } %>
              </dd>
            </div>
            <div>
              <dt>期間内合計</dt>
              <dd><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong></dd>
            </div>
          </dl>
          <form
            id="split-preview-form"
            action="/groups/<%= group.id %>/payments/preview"
            method="post"
            class="payments-split-form"
            <%= isCalculationMode ? "" : "hidden" %>
            data-split-preview-form
          >
            <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
            <input type="hidden" name="contextState" value="open">
            <div class="payments-split-fields">
              <label>
                <span>支払い総額</span>
                <input type="number" name="totalAmount" min="1" step="1" value="<%= splitDraft.totalAmount %>" required inputmode="numeric">
              </label>
              <label>
                <span>実際の取引日</span>
                <input type="date" name="transactionDate" value="<%= splitDraft.transactionDate %>" max="<%= today %>" required>
              </label>
              <label class="payments-split-wide">
                <span>内容・名目</span>
                <textarea name="rawText" maxlength="500" rows="3" required><%= splitDraft.rawText %></textarea>
              </label>
              <label class="payments-split-wide">
                <span>カテゴリ</span>
                <select name="category" required>
                  <option value="">選択してください</option>
                  <% groupPaymentCategories.forEach(category => { %>
                    <option value="<%= category %>" <%= splitDraft.category === category ? "selected" : "" %>><%= category %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <p class="form-help">試算だけではDBへ保存されません。参加者と算出方法も選択してください。</p>
          </form>
          <p class="payments-stage-note" data-normal-stage-note <%= isCalculationMode ? "hidden" : "" %>>表示ページ管理、個別支払い登録、割り勘の試算に対応しています。</p>
        </div>

        <div class="payments-method-area" aria-labelledby="calculation-method-heading">
          <div class="panel-heading compact payments-method-heading">
            <div>
              <p class="eyebrow">割り勘</p>
              <h2 id="calculation-method-heading">算出方法</h2>
            </div>
            <span>4方式</span>
          </div>

          <ul class="payments-method-list">
            <% calculationMethodOptions.forEach((method, index) => { %>
              <li class="<%= isCalculationMode && splitDraft.calculationMethod === method.value ? 'is-selected' : '' %>" data-calculation-method-row>
                <span class="payments-method-action">
                  <button
                    type="button"
                    class="payments-method-help"
                    aria-label="<%= method.label %>の説明を表示"
                    aria-expanded="false"
                    aria-controls="payment-method-description-<%= index %>"
                    data-method-help
                  >?</button>
                  <label class="payments-method-radio" aria-label="<%= method.label %>を選択">
                    <input
                      type="radio"
                      name="calculationMethod"
                      value="<%= method.value %>"
                      form="split-preview-form"
                      data-calculation-method-input
                      <%= splitDraft.calculationMethod === method.value ? "checked" : "" %>
                    >
                  </label>
                </span>
                <strong><%= method.label %></strong>
                <p id="payment-method-description-<%= index %>" class="payments-method-description" hidden><%= method.description %></p>
              </li>
            <% }) %>
          </ul>

          <div class="payments-method-summary" aria-live="polite" data-method-summary>
            <% const selectedMethodOption = calculationMethodOptions.find(method => method.value === splitDraft.calculationMethod); %>
            <%= selectedMethodOption ? selectedMethodOption.description : "算出方法を選択すると、ここに要約を表示します。" %>
          </div>

          <button type="button" class="primary-button payments-start-button" data-start-split <%= isCalculationMode ? "hidden" : "" %>>割り勘を開始</button>
          <div class="payments-calculation-actions" <%= isCalculationMode ? "" : "hidden" %> data-calculation-actions>
            <button type="submit" form="split-preview-form" class="primary-button" data-preview-submit disabled>負担額を試算</button>
            <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState: 'open' }) %>" class="secondary-button button-link">算出を中止</a>
          </div>
        </div>
      </section>

      <section
        class="payments-lower-area<%= contextState === 'closed' ? ' is-context-closed' : '' %>"
        data-payment-lower
        data-context-state="<%= contextState ?? 'auto' %>"
      >
        <section class="payments-context-half" aria-label="表示ページと有効メンバー">
          <div
            class="payments-context-panels"
            id="payment-context-panel"
            aria-hidden="<%= String(contextState === 'closed') %>"
          >
            <section class="panel payments-page-panel">
              <div class="panel-heading compact">
                <div>
                  <p class="eyebrow">期間</p>
                  <h2>表示ページ</h2>
                </div>
                <span><%= pages.length %> 件</span>
              </div>

              <nav class="page-list" aria-label="グループ関連支払いページ">
                <% pages.forEach(page => { %>
                  <a
                    href="<%= buildGroupPaymentsUrl(group.id, { pageId: page.id, contextState }) %>"
                    class="<%= page.id === selectedPage.id ? 'is-active' : '' %>"
                    data-payment-context-link
                    <% if (page.id === selectedPage.id) { %>aria-current="page"<% } %>
                  >
                    <span>
                      <strong><%= page.name %></strong>
                      <small>
                        <% if (page.startDate || page.endDate) { %>
                          <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "指定なし" %>
                          〜
                          <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "指定なし" %>
                        <% } else { %>
                          全期間
                        <% } %>
                      </small>
                    </span>
                    <% if (page.isInitial) { %><small class="initial-badge">初期</small><% } %>
                  </a>
                <% }) %>
              </nav>
            </section>

            <section class="panel payments-member-panel">
              <div class="panel-heading compact">
                <div>
                  <p class="eyebrow">参加候補</p>
                  <h2>有効メンバー</h2>
                </div>
                <span><%= activeMembers.length %> 人</span>
              </div>

              <% if (activeMembers.length === 0) { %>
                <p class="empty-state">有効なメンバーがいません。</p>
              <% } else { %>
                <ul class="payments-member-list">
                  <% activeMembers.forEach(member => { %>
                    <li class="<%= isCalculationMode && splitDraft.participantIds.includes(member.userId) ? 'is-selected' : '' %>" data-participant-row>
                      <span class="payments-member-action">
                        <span class="payments-member-history-label" aria-hidden="true">履歴</span>
                        <label class="payments-member-checkbox" aria-label="<%= member.user.displayName %>を今回の参加者に含める">
                          <input
                            type="checkbox"
                            name="participantIds"
                            value="<%= member.userId %>"
                            form="split-preview-form"
                            data-participant-input
                            <%= splitDraft.participantIds.includes(member.userId) ? "checked" : "" %>
                          >
                        </label>
                      </span>
                      <span class="payments-member-name">
                        <strong><%= member.user.displayName %></strong>
                        <small><%= member.role === "ADMIN" ? "管理者" : "メンバー" %><%= member.userId === currentUserId ? "・あなた" : "" %></small>
                      </span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
              <p class="form-help">メンバー追加・脱退・権限変更はグループ概要で行います。</p>
            </section>
          </div>

          <aside class="payments-operation-rail" aria-label="関連支払いページ操作">
            <button
              type="button"
              data-payment-context-toggle
              aria-controls="payment-context-panel"
              aria-expanded="<%= String(contextState !== 'closed') %>"
              aria-label="<%= isCalculationMode ? '算出中は参加者領域を閉じられません' : '左領域を閉じる' %>"
              title="<%= isCalculationMode ? '算出中は参加者領域を閉じられません' : '左領域を閉じる' %>"
              <%= isCalculationMode ? "disabled" : "" %>
              data-calculation-lock-toggle
            >←</button>
            <button
              type="button"
              data-open-payment-dialog="payments-page-edit-dialog"
              <%= isAdmin ? "" : "disabled" %>
              aria-disabled="<%= String(!isAdmin) %>"
              aria-label="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
              title="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
            >⚙</button>
            <button
              type="button"
              data-open-payment-dialog="payments-page-add-dialog"
              <%= isAdmin ? "" : "disabled" %>
              aria-disabled="<%= String(!isAdmin) %>"
              aria-label="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
              title="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
            >＋</button>
            <button
              type="submit"
              form="payments-delete-page-form"
              <%= !isAdmin || selectedPage.isInitial ? "disabled" : "" %>
              aria-disabled="<%= String(!isAdmin || selectedPage.isInitial) %>"
              aria-label="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
              title="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
            >−</button>
          </aside>

          <section class="panel payments-collapsed-summary" aria-hidden="true">
            <p class="eyebrow">期間内サマリー</p>
            <h2><%= selectedPage.name %></h2>
            <p><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong></p>
            <p><%= transactions.length %> 件・<%= perPersonRows.length %> 人</p>
          </section>
        </section>

        <section class="panel payments-history-panel" aria-labelledby="payment-history-heading">
          <div class="panel-heading payments-history-heading">
            <div>
              <p class="eyebrow">確定済みTransaction</p>
              <h2 id="payment-history-heading">関連支払い履歴</h2>
            </div>
            <button
              type="button"
              class="payments-history-add"
              data-open-payment-dialog="payments-transaction-add-dialog"
              aria-label="個別支払いを登録"
              title="個別支払いを登録"
            >＋</button>
          </div>

          <div class="payments-history-tabs" role="tablist" aria-label="履歴表示方法">
            <button
              type="button"
              role="tab"
              id="payments-chronological-tab"
              aria-controls="payments-chronological-panel"
              aria-selected="true"
              tabindex="0"
              data-payment-tab="chronological"
            >時系列</button>
            <button
              type="button"
              role="tab"
              id="payments-person-tab"
              aria-controls="payments-person-panel"
              aria-selected="false"
              tabindex="-1"
              data-payment-tab="person"
            >人ごと</button>
          </div>

          <section
            id="payments-chronological-panel"
            role="tabpanel"
            aria-labelledby="payments-chronological-tab"
            data-payment-tab-panel="chronological"
          >
            <div class="payments-ledger payments-ledger-chronological" aria-label="時系列の関連支払い履歴">
              <div class="payments-ledger-heading" aria-hidden="true">
                <span>日付</span><span>負担内容</span><span>金額</span><span>名前</span>
              </div>
              <div class="payments-ledger-scroll" tabindex="0" aria-label="時系列履歴。上下にスクロールできます">
                <% if (transactions.length === 0) { %>
                  <p class="empty-state payments-history-empty">この期間には、まだ関連支払いがありません。</p>
                <% } else { %>
                  <% transactions.forEach(transaction => { %>
                    <article class="payments-ledger-row">
                      <time datetime="<%= transaction.transactionDate.toISOString().slice(0, 10) %>"><%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %></time>
                      <span class="payments-ledger-text" tabindex="0" data-payment-tooltip="<%= transaction.rawText %>"><%= transaction.rawText %></span>
                      <strong><%= transaction.amount.toLocaleString("ja-JP") %> 円</strong>
                      <span><%= transaction.user?.displayName ?? "不明なユーザー" %></span>
                    </article>
                  <% }) %>
                <% } %>
              </div>
              <div class="payments-ledger-total">
                <span>—</span><strong>総額</strong><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong><span>—</span>
              </div>
            </div>
          </section>

          <section
            id="payments-person-panel"
            role="tabpanel"
            aria-labelledby="payments-person-tab"
            data-payment-tab-panel="person"
            hidden
          >
            <div class="payments-ledger payments-ledger-person" aria-label="人ごとの関連支払い集計">
              <div class="payments-ledger-heading" aria-hidden="true">
                <span>名前</span><span>合計支払額</span><span>支払い件数</span>
              </div>
              <div class="payments-ledger-scroll" tabindex="0" aria-label="人ごとの集計。上下にスクロールできます">
                <% if (perPersonRows.length === 0) { %>
                  <p class="empty-state payments-history-empty">この期間に集計できる支払いがありません。</p>
                <% } else { %>
                  <% perPersonRows.forEach(row => { %>
                    <article class="payments-ledger-row">
                      <strong><%= row.displayName %></strong>
                      <strong><%= row.totalAmount.toLocaleString("ja-JP") %> 円</strong>
                      <span><%= row.paymentCount.toLocaleString("ja-JP") %> 件</span>
                    </article>
                  <% }) %>
                <% } %>
              </div>
              <div class="payments-ledger-total">
                <strong>合計</strong><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong><span><%= transactions.length.toLocaleString("ja-JP") %> 件</span>
              </div>
            </div>
          </section>
        </section>
      </section>
    </section>

    <aside class="panel payments-result-column" aria-labelledby="payment-result-heading" data-payment-result-column>
      <% if (preview) { %>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">今回の試算</p>
            <h2 id="payment-result-heading">今回の試算結果</h2>
          </div>
          <span><%= preview.allocations.length %> 人</span>
        </div>

        <dl class="payments-batch-definition">
          <div><dt>取引日</dt><dd><%= new Date(splitDraft.transactionDate + "T00:00:00Z").toLocaleDateString("ja-JP") %></dd></div>
          <div><dt>内容</dt><dd><span tabindex="0" data-payment-tooltip="<%= splitDraft.rawText %>"><%= splitDraft.rawText %></span></dd></div>
          <div><dt>カテゴリ</dt><dd><%= splitDraft.category %></dd></div>
          <div><dt>選択方式</dt><dd><%= preview.selectedMethodLabel %></dd></div>
          <% if (preview.usedMethod !== preview.selectedMethod) { %>
            <div><dt>実使用方式</dt><dd><strong><%= preview.usedMethodLabel %></strong></dd></div>
          <% } %>
          <div><dt>総額</dt><dd><strong><%= preview.totalAmount.toLocaleString("ja-JP") %> 円</strong></dd></div>
        </dl>

        <% if (preview.fallbackReason) { %>
          <p class="payments-fallback-message" role="status"><strong>均等割へfallback</strong><br><%= preview.fallbackReason %></p>
        <% } %>

        <h3 class="payments-allocation-heading">参加者別負担額</h3>
        <ul class="payments-preview-allocation-list">
          <% preview.allocations.forEach(allocation => { %>
            <li>
              <div>
                <strong><%= allocation.displayName %></strong>
                <small>算出前比率 <%= allocation.ratioPercent.toLocaleString("ja-JP", { maximumFractionDigits: 2 }) %>%</small>
                <small>正確値 <%= allocation.exactAmount.toLocaleString("ja-JP", { minimumFractionDigits: 2, maximumFractionDigits: 4 }) %> 円</small>
              </div>
              <strong><%= allocation.amount.toLocaleString("ja-JP") %> 円</strong>
            </li>
          <% }) %>
        </ul>
        <div class="payments-preview-total"><span>合計</span><strong><%= preview.allocations.reduce((sum, allocation) => sum + allocation.amount, 0).toLocaleString("ja-JP") %> 円</strong></div>
        <form id="split-confirm-form" action="/groups/<%= group.id %>/payments/confirm" method="post" hidden>
          <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
          <input type="hidden" name="contextState" value="open">
          <input type="hidden" name="totalAmount" value="<%= splitDraft.totalAmount %>">
          <input type="hidden" name="transactionDate" value="<%= splitDraft.transactionDate %>">
          <input type="hidden" name="rawText" value="<%= splitDraft.rawText %>">
          <input type="hidden" name="category" value="<%= splitDraft.category %>">
          <input type="hidden" name="calculationMethod" value="<%= splitDraft.calculationMethod %>">
          <input type="hidden" name="previewSignature" value="<%= previewSignature ?? '' %>">
          <% splitDraft.participantIds.forEach(participantId => { %>
            <input type="hidden" name="participantIds" value="<%= participantId %>">
          <% }) %>
        </form>
        <div class="payments-preview-actions">
          <button type="submit" form="split-confirm-form" class="primary-button" data-preview-confirm-button>確認へ進む</button>
          <button type="button" class="secondary-button" data-edit-split-conditions>条件を修正</button>
          <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState: 'open' }) %>" class="secondary-button button-link">算出を中止</a>
        </div>
        <p class="form-help" data-preview-stale-message hidden>条件を変更したため、この試算結果は古くなりました。もう一度「負担額を試算」してください。</p>
        <p class="form-help">この試算結果はまだDBへ保存されていません。</p>
      <% } else if (isCalculationMode) { %>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">今回の試算</p>
            <h2 id="payment-result-heading">今回の試算を準備中</h2>
          </div>
        </div>
        <div class="payments-result-empty">
          <strong>支払い情報、参加者、算出方法を指定してください。</strong>
          <p>必要な項目が揃うと「負担額を試算」を実行できます。試算だけではDBへ保存されません。</p>
        </div>
        <% if (latestBatch) { %>
          <details class="payments-previous-batch-during-calculation">
            <summary>前回確定分を確認</summary>
            <p><strong><%= latestBatch.rawText %></strong></p>
            <p><%= latestBatch.totalAmount.toLocaleString("ja-JP") %> 円・<%= latestBatch.calculationMethodLabel %></p>
          </details>
        <% } %>
      <% } else { %>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">前回確定分</p>
            <h2 id="payment-result-heading">直近の割り勘結果</h2>
          </div>
          <% if (latestBatch) { %><span><%= latestBatch.allocations.length %> 人</span><% } %>
        </div>

        <% if (!latestBatch) { %>
          <div class="payments-result-empty">
            <strong>まだ確定済みの割り勘結果はありません。</strong>
            <p>参加者と算出方法を選択して、最初の割り勘を開始できます。</p>
          </div>
        <% } else { %>
          <dl class="payments-batch-definition">
            <div><dt>取引日</dt><dd><%= new Date(latestBatch.transactionDate).toLocaleDateString("ja-JP") %></dd></div>
            <div><dt>内容</dt><dd><span tabindex="0" data-payment-tooltip="<%= latestBatch.rawText %>"><%= latestBatch.rawText %></span></dd></div>
            <div><dt>カテゴリ</dt><dd><%= latestBatch.category %></dd></div>
            <div><dt>算出方法</dt><dd><%= latestBatch.calculationMethodLabel %></dd></div>
            <div><dt>総額</dt><dd><strong><%= latestBatch.totalAmount.toLocaleString("ja-JP") %> 円</strong></dd></div>
          </dl>
          <h3 class="payments-allocation-heading">参加者別負担額</h3>
          <ul class="payments-allocation-list">
            <% latestBatch.allocations.forEach(allocation => { %>
              <li><span><%= allocation.displayName %></span><strong><%= allocation.amount.toLocaleString("ja-JP") %> 円</strong></li>
            <% }) %>
          </ul>
        <% } %>
      <% } %>
    </aside>
  </main>

  <dialog class="payments-page-dialog payments-transaction-dialog" id="payments-transaction-add-dialog" aria-labelledby="payments-transaction-add-title">
    <form action="/groups/<%= group.id %>/payments/transactions" method="post" class="page-form payments-dialog-form" data-ai-classification-form data-ai-target="GROUP_PAYMENT" data-ai-group-id="<%= group.id %>">
      <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
      <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>
      <input type="hidden" name="suggestionToken" value="" data-ai-suggestion-token>

      <div class="payments-dialog-heading">
        <div>
          <p class="eyebrow">個別支払い</p>
          <h2 id="payments-transaction-add-title">関連支払いを登録</h2>
        </div>
        <button type="button" class="payments-dialog-close" data-close-payment-dialog aria-label="閉じる" title="閉じる">×</button>
      </div>

      <p class="form-help payments-self-payment-note">
        <strong><%= currentUserDisplayName %></strong>さん本人が、自分の財布から支払った金額として登録します。他人名義では登録できません。
      </p>

      <label>
        <span>実際の取引日</span>
        <input type="date" name="transactionDate" value="<%= today %>" max="<%= today %>" required>
      </label>

      <label>
        <span>金額</span>
        <input type="number" name="amount" min="1" step="1" inputmode="numeric" required>
      </label>

      <label>
        <span>カテゴリ</span>
        <select name="category" required>
          <option value="">選択してください</option>
          <% groupPaymentCategories.forEach(category => { %>
            <option value="<%= category %>"><%= category %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>内容・名目</span>
        <textarea name="rawText" maxlength="500" rows="4" placeholder="例：昨日部活動の会場利用料を3000円払った" required data-ai-raw-text></textarea>
      </label>

      <div class="ai-classification-actions">
        <button type="button" class="secondary-button" data-ai-classify-button>AIで推定</button>
        <p class="form-help">押すと、この内容だけを外部AI（OpenAI）へ送信します。候補は自動保存されません。</p>
      </div>
      <section class="ai-suggestion-panel" data-ai-suggestion-panel hidden aria-live="polite">
        <p class="ai-suggestion-message" data-ai-message></p>
        <dl class="ai-field-status" data-ai-field-status></dl>
        <ul class="ai-warning-list" data-ai-warnings hidden></ul>
      </section>

      <p class="form-help">登録する1件のTransactionを、本人の個人家計簿とこのグループの関連支払い履歴から参照します。</p>
      <div class="payments-dialog-actions">
        <button type="button" class="secondary-button" data-close-payment-dialog>キャンセル</button>
        <button type="submit" class="primary-button">個別支払いを登録</button>
      </div>
    </form>
  </dialog>

  <% if (isAdmin) { %>
    <dialog class="payments-page-dialog" id="payments-page-add-dialog" aria-labelledby="payments-page-add-title">
      <form action="/groups/<%= group.id %>/payments/pages" method="post" class="page-form payments-dialog-form">
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>

        <div class="payments-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="payments-page-add-title">表示ページを追加</h2>
          </div>
          <button type="button" class="payments-dialog-close" data-close-payment-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate">
          </label>
        </div>

        <p class="form-help">日付を空欄にすると、その方向の期間を制限しません。</p>
        <div class="payments-dialog-actions">
          <button type="button" class="secondary-button" data-close-payment-dialog>キャンセル</button>
          <button type="submit" class="primary-button">ページを追加</button>
        </div>
      </form>
    </dialog>

    <dialog class="payments-page-dialog" id="payments-page-edit-dialog" aria-labelledby="payments-page-edit-title">
      <form action="/groups/<%= group.id %>/payments/pages/<%= selectedPage.id %>" method="post" class="page-form payments-dialog-form">
        <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>

        <div class="payments-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="payments-page-edit-title">選択中ページを編集</h2>
          </div>
          <button type="button" class="payments-dialog-close" data-close-payment-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" value="<%= selectedPage.name %>" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate" value="<%= selectedPageForm.startDate %>">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate" value="<%= selectedPageForm.endDate %>">
          </label>
        </div>

        <p class="form-help">初期ページも名前と期間を編集できます。初期ページの属性と削除不可状態は維持されます。</p>
        <div class="payments-dialog-actions">
          <button type="button" class="secondary-button" data-close-payment-dialog>キャンセル</button>
          <button type="submit" class="primary-button">変更を保存</button>
        </div>
      </form>
    </dialog>

    <form
      id="payments-delete-page-form"
      action="/groups/<%= group.id %>/payments/pages/<%= selectedPage.id %>/delete"
      method="post"
      class="payments-hidden-form"
      onsubmit="return confirm('選択中の表示ページを削除しますか？関連支払いTransaction自体は削除されません。');"
    >
      <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>
    </form>
  <% } %>

  <script>
    (() => {
      const lowerArea = document.querySelector("[data-payment-lower]");
      const toggle = document.querySelector("[data-payment-context-toggle]");
      const contextPanel = document.getElementById("payment-context-panel");
      const contextLinks = document.querySelectorAll("[data-payment-context-link]");
      const contextStateInputs = document.querySelectorAll("[data-payment-context-state]");

      const setContextOpen = (isOpen, persistInLinks = true) => {
        if (!(lowerArea instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(contextPanel instanceof HTMLElement)) return;

        lowerArea.classList.toggle("is-context-closed", !isOpen);
        lowerArea.dataset.contextState = isOpen ? "open" : "closed";
        toggle.textContent = isOpen ? "←" : "→";
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isOpen ? "左領域を閉じる" : "左領域を開く");
        toggle.setAttribute("title", isOpen ? "左領域を閉じる" : "左領域を開く");
        contextPanel.setAttribute("aria-hidden", String(!isOpen));

        const contextState = isOpen ? "open" : "closed";
        contextStateInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = contextState;
        });

        if (!persistInLinks) return;
        contextLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          url.searchParams.set("context", isOpen ? "open" : "closed");
          link.href = `${url.pathname}${url.search}${url.hash}`;
        });
      };

      if (lowerArea instanceof HTMLElement && toggle instanceof HTMLButtonElement && contextPanel instanceof HTMLElement) {
        const explicitState = lowerArea.dataset.contextState;
        const initialOpen = explicitState === "open" || (explicitState !== "closed" && !window.matchMedia("(max-width: 760px)").matches);
        setContextOpen(initialOpen, explicitState === "open" || explicitState === "closed");
        toggle.addEventListener("click", () => setContextOpen(toggle.getAttribute("aria-expanded") !== "true"));
      }

      const body = document.body;
      const splitForm = document.querySelector("[data-split-preview-form]");
      const startSplitButton = document.querySelector("[data-start-split]");
      const calculationActions = document.querySelector("[data-calculation-actions]");
      const previewSubmit = document.querySelector("[data-preview-submit]");
      const participantInputs = [...document.querySelectorAll("[data-participant-input]")];
      const methodInputs = [...document.querySelectorAll("[data-calculation-method-input]")];
      const methodSummary = document.querySelector("[data-method-summary]");
      const resultColumn = document.querySelector("[data-payment-result-column]");
      const previewConfirmButton = document.querySelector("[data-preview-confirm-button]");
      const previewStaleMessage = document.querySelector("[data-preview-stale-message]");
      const previousBatchSummary = <%- JSON.stringify(latestBatch ? {
        totalAmount: latestBatch.totalAmount,
        calculationMethodLabel: latestBatch.calculationMethodLabel,
      } : null) %>;
      const methodDescriptions = <%- JSON.stringify(Object.fromEntries(calculationMethodOptions.map(method => [method.value, method.description]))) %>;

      const invalidateRenderedPreview = () => {
        if (!(previewConfirmButton instanceof HTMLButtonElement)) return;
        previewConfirmButton.disabled = true;
        previewConfirmButton.setAttribute("aria-disabled", "true");
        if (previewStaleMessage instanceof HTMLElement) previewStaleMessage.hidden = false;
      };

      const updateCalculationSelections = () => {
        participantInputs.forEach((input) => {
          const row = input.closest("[data-participant-row]");
          if (row) row.classList.toggle("is-selected", input.checked);
        });
        methodInputs.forEach((input) => {
          const row = input.closest("[data-calculation-method-row]");
          if (row) row.classList.toggle("is-selected", input.checked);
        });
        const selectedMethod = methodInputs.find((input) => input.checked);
        if (methodSummary) {
          methodSummary.textContent = selectedMethod
            ? methodDescriptions[selectedMethod.value]
            : "算出方法を選択すると、ここに要約を表示します。";
        }
      };

      const updatePreviewAvailability = () => {
        if (!(splitForm instanceof HTMLFormElement) || !(previewSubmit instanceof HTMLButtonElement)) return;
        const hasParticipant = participantInputs.some((input) => input.checked);
        const hasMethod = methodInputs.some((input) => input.checked);
        previewSubmit.disabled = !(splitForm.checkValidity() && hasParticipant && hasMethod);
      };

      const enterCalculationMode = () => {
        body.classList.add("is-calculation-mode");
        body.dataset.calculationMode = "true";
        if (splitForm instanceof HTMLElement) splitForm.hidden = false;
        if (startSplitButton instanceof HTMLElement) startSplitButton.hidden = true;
        if (calculationActions instanceof HTMLElement) calculationActions.hidden = false;
        participantInputs.forEach((input) => { input.checked = true; });
        methodInputs.forEach((input) => { input.checked = false; });
        setContextOpen(true);
        if (toggle instanceof HTMLButtonElement) {
          toggle.disabled = true;
          toggle.setAttribute("aria-label", "算出中は参加者領域を閉じられません");
          toggle.setAttribute("title", "算出中は参加者領域を閉じられません");
        }
        if (resultColumn instanceof HTMLElement) {
          const previousBatchDetails = previousBatchSummary
            ? `<details class="payments-previous-batch-during-calculation">
                <summary>前回確定分を確認</summary>
                <p><strong>直近の確定済み割り勘</strong></p>
                <p>${Number(previousBatchSummary.totalAmount).toLocaleString("ja-JP")} 円・${String(previousBatchSummary.calculationMethodLabel)}</p>
              </details>`
            : "";
          resultColumn.innerHTML = `
            <div class="panel-heading">
              <div><p class="eyebrow">今回の試算</p><h2 id="payment-result-heading">今回の試算を準備中</h2></div>
            </div>
            <div class="payments-result-empty">
              <strong>支払い情報、参加者、算出方法を指定してください。</strong>
              <p>必要な項目が揃うと「負担額を試算」を実行できます。試算だけではDBへ保存されません。</p>
            </div>
            ${previousBatchDetails}`;
        }
        updateCalculationSelections();
        updatePreviewAvailability();
        const firstInput = splitForm?.querySelector("input:not([type='hidden'])");
        if (firstInput instanceof HTMLElement) firstInput.focus();
      };

      startSplitButton?.addEventListener("click", enterCalculationMode);
      [...participantInputs, ...methodInputs].forEach((input) => {
        input.addEventListener("change", () => {
          updateCalculationSelections();
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
      });
      splitForm?.querySelectorAll("input, textarea, select").forEach((input) => {
        input.addEventListener("input", () => {
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
        input.addEventListener("change", () => {
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
      });
      document.querySelector("[data-edit-split-conditions]")?.addEventListener("click", () => {
        invalidateRenderedPreview();
        const firstInput = splitForm?.querySelector("input:not([type='hidden'])");
        if (firstInput instanceof HTMLElement) firstInput.focus();
        splitForm?.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      if (body.classList.contains("is-calculation-mode")) {
        setContextOpen(true);
        if (toggle instanceof HTMLButtonElement) {
          toggle.disabled = true;
          toggle.setAttribute("aria-label", "算出中は参加者領域を閉じられません");
          toggle.setAttribute("title", "算出中は参加者領域を閉じられません");
        }
        updateCalculationSelections();
        updatePreviewAvailability();
      }

      const tabs = [...document.querySelectorAll("[data-payment-tab]")];
      const panels = [...document.querySelectorAll("[data-payment-tab-panel]")];
      const activateTab = (name, focus = false) => {
        tabs.forEach((tab) => {
          const selected = tab.getAttribute("data-payment-tab") === name;
          tab.setAttribute("aria-selected", String(selected));
          tab.setAttribute("tabindex", selected ? "0" : "-1");
          if (selected && focus && tab instanceof HTMLElement) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-payment-tab-panel") !== name;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(tab.getAttribute("data-payment-tab")));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const offset = event.key === "ArrowRight" ? 1 : -1;
          const next = tabs[(index + offset + tabs.length) % tabs.length];
          activateTab(next.getAttribute("data-payment-tab"), true);
        });
      });

      document.querySelectorAll("[data-method-help]").forEach((button) => {
        button.addEventListener("click", () => {
          const controlledId = button.getAttribute("aria-controls");
          const description = controlledId ? document.getElementById(controlledId) : null;
          if (!description) return;
          const willOpen = description.hidden;
          document.querySelectorAll("[data-method-help]").forEach((other) => other.setAttribute("aria-expanded", "false"));
          document.querySelectorAll(".payments-method-list p").forEach((item) => { item.hidden = true; });
          description.hidden = !willOpen;
          button.setAttribute("aria-expanded", String(willOpen));
        });
      });

      document.querySelectorAll("[data-open-payment-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialogId = button.getAttribute("data-open-payment-dialog");
          const dialog = dialogId ? document.getElementById(dialogId) : null;
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      document.querySelectorAll("[data-close-payment-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = button.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      document.querySelectorAll(".payments-page-dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      const statusLabels = { EXPLICIT: "入力に明記", INFERRED: "AI・規則で推定", DEFAULTED: "画面の既定値", MISSING: "要入力" };
      document.querySelectorAll("[data-ai-classification-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;
        const button = form.querySelector("[data-ai-classify-button]");
        const rawText = form.elements.namedItem("rawText");
        const amount = form.elements.namedItem("amount");
        const date = form.elements.namedItem("transactionDate");
        const category = form.elements.namedItem("category");
        const token = form.querySelector("[data-ai-suggestion-token]");
        const panel = form.querySelector("[data-ai-suggestion-panel]");
        const message = form.querySelector("[data-ai-message]");
        const statuses = form.querySelector("[data-ai-field-status]");
        const warnings = form.querySelector("[data-ai-warnings]");
        button?.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement) || !(rawText instanceof HTMLTextAreaElement)) return;
          const text = rawText.value.trim();
          if (!text) { rawText.setCustomValidity("AIで推定する内容を入力してください。"); rawText.reportValidity(); rawText.setCustomValidity(""); return; }
          button.disabled = true; button.textContent = "推定中…"; form.setAttribute("aria-busy", "true");
          if (panel instanceof HTMLElement) panel.hidden = false;
          if (message instanceof HTMLElement) message.textContent = "AIで候補を作成しています。";
          try {
            const response = await fetch("/api/ai/classify-transaction", {
              method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, credentials: "same-origin",
              body: JSON.stringify({ target: form.dataset.aiTarget, groupId: Number(form.dataset.aiGroupId), rawText: text }),
            });
            const payload = await response.json().catch(() => null);
            if (!payload?.suggestion) throw new Error(payload?.message || "AI候補を取得できませんでした。");
            const suggestion = payload.suggestion;
            if (amount instanceof HTMLInputElement && suggestion.amount !== null) amount.value = String(suggestion.amount);
            if (date instanceof HTMLInputElement) date.value = suggestion.transactionDate || payload.referenceDate || date.value;
            if (category instanceof HTMLSelectElement) category.value = suggestion.category || "";
            if (payload.source === "AI" && suggestion.summary) rawText.value = suggestion.summary;
            if (token instanceof HTMLInputElement) token.value = payload.suggestionToken || "";
            if (message instanceof HTMLElement) { message.textContent = payload.message || "候補を表示しました。"; message.dataset.source = payload.source || ""; }
            if (statuses instanceof HTMLElement) {
              statuses.replaceChildren();
              [["種類", suggestion.fieldStatus?.transactionType], ["金額", suggestion.fieldStatus?.amount], ["取引日", suggestion.transactionDate ? suggestion.fieldStatus?.transactionDate : "DEFAULTED"], ["カテゴリ", suggestion.fieldStatus?.category]].forEach(([label, status]) => {
                const dt = document.createElement("dt"); dt.textContent = label;
                const dd = document.createElement("dd"); dd.textContent = statusLabels[status] || "要確認"; dd.dataset.status = status || "";
                statuses.append(dt, dd);
              });
            }
            if (warnings instanceof HTMLUListElement) {
              warnings.replaceChildren();
              (Array.isArray(suggestion.warnings) ? suggestion.warnings : []).forEach((value) => { const li = document.createElement("li"); li.textContent = String(value); warnings.append(li); });
              warnings.hidden = warnings.children.length === 0;
            }
          } catch (error) {
            if (message instanceof HTMLElement) { message.textContent = error instanceof Error ? error.message : "AI候補を取得できませんでした。"; message.dataset.source = "ERROR"; }
          } finally { button.disabled = false; button.textContent = "AIで推定"; form.removeAttribute("aria-busy"); }
        });
      });

      document.querySelectorAll("form[method='post']").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (event.defaultPrevented) return;

          if (form.dataset.submitting === "true") {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          form.dataset.submitting = "true";
          form.setAttribute("aria-busy", "true");
          const submitControls = [
            ...form.querySelectorAll("button[type='submit'], input[type='submit']"),
            ...(form.id
              ? document.querySelectorAll(`button[type="submit"][form="${form.id}"], input[type="submit"][form="${form.id}"]`)
              : []),
          ];
          submitControls.forEach((control) => {
            if (control instanceof HTMLButtonElement) {
              control.textContent = "処理中…";
              control.disabled = true;
            } else if (control instanceof HTMLInputElement) {
              control.value = "処理中…";
              control.disabled = true;
            }
          });
        });
      });

      const tooltip = document.createElement("div");
      tooltip.className = "payments-tooltip";
      tooltip.setAttribute("role", "tooltip");
      tooltip.hidden = true;
      document.body.append(tooltip);

      const hideTooltip = () => {
        tooltip.hidden = true;
        tooltip.textContent = "";
      };
      const showTooltip = (target) => {
        if (!(target instanceof HTMLElement)) return;
        const text = target.dataset.paymentTooltip;
        if (!text || target.scrollWidth <= target.clientWidth) {
          hideTooltip();
          return;
        }
        tooltip.textContent = text;
        tooltip.hidden = false;
        const rect = target.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const padding = 12;
        let left = Math.max(padding, Math.min(rect.left, window.innerWidth - tooltipRect.width - padding));
        let top = rect.bottom + 8;
        if (top + tooltipRect.height > window.innerHeight - padding) top = Math.max(padding, rect.top - tooltipRect.height - 8);
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${top}px`;
      };
      document.querySelectorAll("[data-payment-tooltip]").forEach((target) => {
        target.addEventListener("mouseenter", () => showTooltip(target));
        target.addEventListener("mouseleave", hideTooltip);
        target.addEventListener("focus", () => showTooltip(target));
        target.addEventListener("blur", hideTooltip);
        target.addEventListener("click", () => tooltip.hidden ? showTooltip(target) : hideTooltip());
      });
      window.addEventListener("resize", hideTooltip);
      window.addEventListener("scroll", hideTooltip, { passive: true, capture: true });
    })();
  </script>
</body>
</html>
