<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>家計簿・割り勘アプリ</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-layout">
    <div class="auth-side" aria-hidden="true"></div>
    <section class="auth-panel">
      <div class="auth-card">
        <h1>家計簿・割り勘アプリ</h1>
        <nav class="auth-tabs" aria-label="認証方法">
          <a href="/" class="<%= mode === 'login' ? 'is-active' : '' %>">ログイン</a>
          <a href="/?mode=register" class="<%= mode === 'register' ? 'is-active' : '' %>">新規登録</a>
        </nav>

        <% if (error) { %>
          <p class="error-message" role="alert"><%= error %></p>
        <% } %>

        <% if (mode === "register") { %>
          <form action="/register" method="post" class="auth-form">
            <label><span>ログインID</span><input type="text" name="loginId" value="<%= values.loginId %>" autocomplete="username" maxlength="50" required></label>
            <label><span>表示名</span><input type="text" name="displayName" value="<%= values.displayName %>" autocomplete="name" maxlength="100" required></label>
            <label><span>Password</span><input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
            <button type="submit" class="submit-button" aria-label="新規登録">→</button>
          </form>
        <% } else { %>
          <form action="/login" method="post" class="auth-form">
            <label><span>ログインID</span><input type="text" name="loginId" value="<%= values.loginId %>" autocomplete="username" maxlength="50" required></label>
            <label><span>Password</span><input type="password" name="password" autocomplete="current-password" required></label>
            <button type="submit" class="submit-button" aria-label="ログイン">→</button>
          </form>
        <% } %>
      </div>
    </section>
    <div class="auth-side" aria-hidden="true"></div>
  </main>
</body>
</html>
