<header class="app-header" data-app-header>
  <div class="app-header__inner">
    <% if (header.mode === "personal") { %>
      <form action="/logout" method="post" class="app-header__logout">
        <button type="submit" class="secondary-button">ログアウト</button>
      </form>
    <% } else { %>
      <button
        type="button"
        class="app-header__menu-toggle"
        aria-expanded="false"
        aria-controls="group-app-navigation"
        data-app-header-menu-toggle
      >
        <span aria-hidden="true">☰</span>
        <span>メニュー</span>
      </button>
      <nav
        id="group-app-navigation"
        class="header-actions group-header-nav app-header__nav"
        aria-label="グループ画面ナビゲーション"
        data-app-header-nav
      >
        <a href="/app" class="secondary-button button-link group-nav-item">自分の家計簿</a>
        <a
          href="/groups/<%= header.groupId %>"
          class="secondary-button button-link group-nav-item<%= header.active === 'overview' ? ' is-active' : '' %>"
          <% if (header.active === "overview") { %>aria-current="page"<% } %>
        >概要</a>
        <a
          href="<%= header.fundHref || `/groups/${header.groupId}/fund` %>"
          class="secondary-button button-link group-nav-item<%= header.active === 'fund' ? ' is-active' : '' %>"
          <% if (header.active === "fund") { %>aria-current="page" data-fund-context-link<% } %>
        >基金</a>
        <a
          href="<%= header.paymentsHref || `/groups/${header.groupId}/payments` %>"
          class="secondary-button button-link group-nav-item<%= header.active === 'payments' ? ' is-active' : '' %>"
          <% if (header.active === "payments") { %>aria-current="page" data-payment-context-link<% } %>
        >割り勘</a>
        <form action="/logout" method="post" class="group-nav-logout">
          <button type="submit" class="secondary-button group-nav-item">ログアウト</button>
        </form>
      </nav>
    <% } %>
  </div>
</header>

<script>
  (() => {
    const url = new URL(window.location.href);
    let changed = false;

    for (const key of ["success", "error"]) {
      if (url.searchParams.has(key)) {
        url.searchParams.delete(key);
        changed = true;
      }
    }

    if (changed) {
      window.history.replaceState(
        window.history.state,
        "",
        `${url.pathname}${url.search}${url.hash}`,
      );
    }

    const header = document.querySelector("[data-app-header]");
    const menuToggle = header?.querySelector("[data-app-header-menu-toggle]");
    const navigation = header?.querySelector("[data-app-header-nav]");
    const mobileQuery = window.matchMedia("(max-width: 820px)");

    if (!(menuToggle instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) return;

    const setMenuOpen = (isOpen) => {
      const shouldShow = !mobileQuery.matches || isOpen;
      navigation.hidden = !shouldShow;
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.classList.toggle("is-open", isOpen);
    };

    const syncMenuForViewport = () => {
      setMenuOpen(!mobileQuery.matches);
    };

    menuToggle.addEventListener("click", () => {
      setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    navigation.addEventListener("click", (event) => {
      if (mobileQuery.matches && event.target instanceof HTMLAnchorElement) setMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileQuery.matches && menuToggle.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    mobileQuery.addEventListener?.("change", syncMenuForViewport);
    syncMenuForViewport();
  })();
</script>
