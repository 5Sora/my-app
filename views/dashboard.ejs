<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.displayName %> の家計簿</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="dashboard-body">
  <main class="dashboard-card">
    <div>
      <p class="dashboard-label">ログイン中</p>
      <h1><%= user.displayName %> の家計簿</h1>
      <p>ログインID: <%= user.loginId %></p>
      <% if (initialPage) { %>
        <p>初期ページ: <%= initialPage.name %></p>
      <% } else { %>
        <p class="error-message">初期ページが見つかりません。</p>
      <% } %>
      <p class="dashboard-note">認証機能の確認用画面です。次の工程で個人家計簿画面へ置き換えます。</p>
    </div>
    <form action="/logout" method="post">
      <button type="submit" class="logout-button">ログアウト</button>
    </form>
  </main>
</body>
</html>
