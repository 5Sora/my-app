<!DOCTYPE html>
<%
  const paymentVisualizationView = typeof paymentVisualization !== "undefined" && paymentVisualization
    ? paymentVisualization
    : {
        paymentComposition: [],
        totals: { amount: 0, paymentCount: 0, participantCount: 0 },
      };
%>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> - 関連支払い - <%= selectedPage.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/payments.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <link rel="stylesheet" href="/css/transaction-overlay.css">
</head>
<body class="ledger-body payments-body<%= isCalculationMode ? ' is-calculation-mode' : '' %>" data-calculation-mode="<%= String(isCalculationMode) %>">
  <%- include("partials/app-header", {
    header: {
      mode: "group",
      groupId: group.id,
      active: "payments",
      paymentsHref: buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState })
    }
  }) %>

  <% if (error || success) { %>
    <section class="flash-area" aria-live="polite">
      <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>
      <% if (success) { %><p class="success-message" role="status"><%= success %></p><% } %>
    </section>
  <% } %>

  <main class="ledger-shell payments-shell" aria-label="グループ関連支払い">
    <section class="ledger-shell-top payments-shell-top" aria-label="関連支払いの概要と割り勘操作">
      <article class="panel payments-title-card">
        <p class="eyebrow">関連支払い</p>
        <h1><%= selectedPage.name %></h1>
        <p class="payments-title-group"><strong><%= group.name %></strong></p>
        <p class="period-label">
          <% if (selectedPage.startDate || selectedPage.endDate) { %>
            <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
            〜
            <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
          <% } else { %>
            全期間
          <% } %>
        </p>
        <dl class="payments-title-metrics">
          <div><dt>期間内総額</dt><dd><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong></dd></div>
          <div><dt>記録件数</dt><dd><%= transactions.length.toLocaleString("ja-JP") %> 件</dd></div>
        </dl>
      </article>

      <article class="panel payments-method-area" aria-labelledby="calculation-method-heading">
        <div class="panel-heading compact payments-method-heading">
          <div><p class="eyebrow">割り勘</p><h2 id="calculation-method-heading">算出方法</h2></div>
          <span>4方式</span>
        </div>

        <ul class="payments-method-list">
          <% calculationMethodOptions.forEach((method) => { %>
            <li class="<%= isCalculationMode && splitDraft.calculationMethod === method.value ? 'is-selected' : '' %>" data-calculation-method-row>
              <span class="payments-method-action">
                <button
                  type="button"
                  class="payments-method-help"
                  aria-label="<%= method.label %>の説明を確認"
                  aria-describedby="payment-method-summary"
                  data-method-help
                  data-method-description="<%= method.description %>"
                >?</button>
                <label class="payments-method-radio" aria-label="<%= method.label %>を選択">
                  <input type="radio" name="calculationMethod" value="<%= method.value %>" form="split-preview-form" data-calculation-method-input <%= splitDraft.calculationMethod === method.value ? "checked" : "" %>>
                </label>
              </span>
              <strong><%= method.label %></strong>
            </li>
          <% }) %>
        </ul>

        <div id="payment-method-summary" class="payments-method-summary" aria-live="polite" data-method-summary>
          <% const selectedMethodOption = calculationMethodOptions.find(method => method.value === splitDraft.calculationMethod); %>
          <%= selectedMethodOption ? selectedMethodOption.description : "？を押すと、この欄に算出方法の説明を表示します。" %>
        </div>

        <button type="button" class="primary-button payments-start-button" data-start-split <%= isCalculationMode ? "hidden" : "" %>>割り勘を開始</button>
        <div class="payments-calculation-actions" <%= isCalculationMode ? "" : "hidden" %> data-calculation-actions>
          <button type="button" class="primary-button" data-open-payment-conditions disabled>支払い条件を入力</button>
          <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState: 'open' }) %>" class="secondary-button button-link">算出を中止</a>
        </div>
      </article>

      <article class="panel payments-insight-card" aria-labelledby="payment-share-chart-title" data-payment-share-chart>
        <div class="payments-insight-heading">
          <div>
            <p class="eyebrow">メンバー別支払額割合</p>
            <h2 id="payment-share-chart-title">選択期間に記録された支払額</h2>
          </div>
          <button type="button" class="secondary-button payments-ai-analysis-button" data-ai-analysis-button data-endpoint="/api/ai/analyze-group-payments" data-group-id="<%= group.id %>" data-page-id="<%= selectedPage.id %>" data-page-name="<%= selectedPage.name %>" data-loading-message="選択中の関連支払いページを集計し、AIへ分析を依頼しています。">AI分析</button>
        </div>
        <p class="payments-chart-note">公平性の判定ではなく、選択期間に記録された支払額の割合です。</p>

        <% if (paymentVisualizationView.totals.amount > 0) { %>
          <div class="payments-share-chart">
            <div class="payments-share-chart__visual">
              <svg class="payments-share-chart__pie" viewBox="0 0 100 100" role="img" aria-label="メンバー別支払額割合。合計 <%= paymentVisualizationView.totals.amount.toLocaleString("ja-JP") %> 円">
                <circle class="payments-share-chart__track" cx="50" cy="50" r="38" pathLength="100"></circle>
                <g data-payment-share-segments></g>
              </svg>
              <div class="payments-share-chart__center" aria-hidden="true"><span>総額</span><strong><%= paymentVisualizationView.totals.amount.toLocaleString("ja-JP") %></strong><small>円</small></div>
            </div>
            <div class="payments-share-chart__legend" aria-label="メンバー別支払額割合の凡例">
              <ul>
                <% paymentVisualizationView.paymentComposition.forEach(item => { %>
                  <li>
                    <button type="button" class="payments-share-chart__legend-item" style="--chart-color: <%= item.color %>" data-payment-share-item="<%= item.key %>" aria-label="<%= item.label %>、<%= item.amount.toLocaleString("ja-JP") %>円、<%= item.percentage %>パーセント、<%= item.paymentCount %>件">
                      <span class="payments-share-chart__swatch" aria-hidden="true"></span>
                      <span class="payments-share-chart__legend-name"><strong><%= item.label %></strong><small><%= item.paymentCount %> 件<%= item.amount === 0 ? "・参加記録0円" : "" %></small></span>
                      <span class="payments-share-chart__legend-value"><strong><%= item.amount.toLocaleString("ja-JP") %> 円</strong><small><%= item.percentage.toFixed(1) %>%</small></span>
                    </button>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
          <div class="payments-share-chart__tooltip" role="tooltip" hidden data-payment-share-tooltip></div>
        <% } else { %>
          <div class="payments-chart-empty" role="status"><strong>表示できる支払額がありません</strong><span>0円参加者は履歴に残りますが、円グラフの面積は持ちません。</span></div>
        <% } %>
        <script type="application/json" data-payment-share-chart-data><%- JSON.stringify(paymentVisualizationView.paymentComposition).replace(/</g, "\u003c") %></script>
      </article>
    </section>

    <section class="ledger-shell-lower payments-lower-area<%= !isCalculationMode && contextState !== 'open' ? ' is-context-closed' : '' %>" data-payment-lower data-context-state="<%= contextState ?? 'auto' %>">
      <aside class="payments-context-column" id="payment-context-panel" aria-label="表示ページと有効メンバー" aria-hidden="<%= String(!isCalculationMode && contextState !== 'open') %>">
        <section class="panel payments-page-panel">
          <div class="panel-heading compact"><div><p class="eyebrow">LedgerPage</p><h2>表示ページ</h2></div><span><%= pages.length %> 件</span></div>
          <nav class="page-list" aria-label="グループ関連支払いページ">
            <% pages.forEach(page => { %>
              <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: page.id, contextState }) %>" class="<%= page.id === selectedPage.id ? 'is-active' : '' %>" data-payment-context-link <% if (page.id === selectedPage.id) { %>aria-current="page"<% } %>><span><strong><%= page.name %></strong></span><% if (page.isInitial) { %><small class="initial-badge">初期</small><% } %></a>
            <% }) %>
          </nav>
        </section>

        <section class="panel payments-member-panel">
          <div class="panel-heading compact"><div><p class="eyebrow">参加候補</p><h2>有効メンバー</h2></div><span><%= activeMembers.length %> 人</span></div>
          <% if (activeMembers.length === 0) { %><p class="empty-state">有効なメンバーがいません。</p><% } else { %>
            <ul class="payments-member-list">
              <% activeMembers.forEach(member => { %>
                <li class="<%= isCalculationMode && splitDraft.participantIds.includes(member.userId) ? 'is-selected' : '' %>" data-participant-row>
                  <span class="payments-member-action"><span class="payments-member-history-label" aria-hidden="true">履歴</span><label class="payments-member-checkbox" aria-label="<%= member.user.displayName %>を今回の参加者に含める"><input type="checkbox" name="participantIds" value="<%= member.userId %>" form="split-preview-form" data-participant-input <%= splitDraft.participantIds.includes(member.userId) ? "checked" : "" %>></label></span>
                  <span class="payments-member-name"><strong><%= member.user.displayName %></strong><small><%= member.role === "ADMIN" ? "管理者" : "メンバー" %><%= member.userId === currentUserId ? "・あなた" : "" %></small></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
          <p class="form-help">メンバー管理はグループ概要で行います。</p>
        </section>
      </aside>

      <aside class="payments-operation-rail" aria-label="関連支払いページ操作">
        <button class="ledger-operation-button" type="button" data-payment-context-toggle aria-controls="payment-context-panel" aria-expanded="<%= String(isCalculationMode || contextState === 'open') %>" aria-label="<%= isCalculationMode ? '算出中は参加者領域を閉じられません' : (contextState === 'open' ? '一覧を閉じる' : '一覧を開く') %>" title="<%= isCalculationMode ? '算出中は参加者領域を閉じられません' : (contextState === 'open' ? '一覧を閉じる' : '一覧を開く') %>" <%= isCalculationMode ? "disabled" : "" %> data-calculation-lock-toggle>
          <span class="ledger-operation-icon ledger-operation-icon--desktop" data-operation-desktop-icon aria-hidden="true"><%= isCalculationMode || contextState === "open" ? "←" : "→" %></span>
          <span class="ledger-operation-icon ledger-operation-icon--mobile" data-operation-mobile-icon aria-hidden="true"><%= isCalculationMode || contextState === "open" ? "↑" : "↓" %></span>
          <span class="ledger-operation-label" data-operation-label><%= isCalculationMode ? '算出中' : (contextState === 'open' ? '閉じる' : '開く') %></span>
        </button>
        <button class="ledger-operation-button" type="button" data-open-payment-dialog="payments-page-edit-dialog" <%= isAdmin ? "" : "disabled" %> aria-disabled="<%= String(!isAdmin) %>" aria-label="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>" title="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"><span aria-hidden="true">⚙</span><span class="ledger-operation-label">編集</span></button>
        <button class="ledger-operation-button" type="button" data-open-payment-dialog="payments-page-add-dialog" <%= isAdmin ? "" : "disabled" %> aria-disabled="<%= String(!isAdmin) %>" aria-label="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>" title="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"><span aria-hidden="true">＋</span><span class="ledger-operation-label">ページ追加</span></button>
        <button class="ledger-operation-button" type="submit" form="payments-delete-page-form" <%= !isAdmin || selectedPage.isInitial ? "disabled" : "" %> aria-disabled="<%= String(!isAdmin || selectedPage.isInitial) %>" aria-label="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>" title="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"><span aria-hidden="true">−</span><span class="ledger-operation-label">ページ削除</span></button>
      </aside>

      <aside class="panel payments-latest-batch">
        <div class="panel-heading compact"><div><p class="eyebrow">最新の確定割り勘</p><h2>直近batch</h2></div><% if (latestBatch) { %><span><%= latestBatch.allocations.length %> 人</span><% } %></div>
        <% if (!latestBatch) { %>
          <div class="payments-result-empty"><strong>確定済みの割り勘はありません。</strong><p>割り勘を確定すると、直近結果をここに表示します。</p></div>
        <% } else { %>
          <dl class="payments-latest-definition">
            <div><dt>取引日</dt><dd><%= new Date(latestBatch.transactionDate).toLocaleDateString("ja-JP") %></dd></div>
            <div><dt>内容</dt><dd><span tabindex="0" data-payment-tooltip="<%= latestBatch.rawText %>"><%= latestBatch.rawText %></span></dd></div>
            <div><dt>総額</dt><dd><strong><%= latestBatch.totalAmount.toLocaleString("ja-JP") %> 円</strong></dd></div>
            <div><dt>選択方式</dt><dd>現行保存形式では未保持</dd></div>
            <div><dt>実使用方式</dt><dd><strong><%= latestBatch.calculationMethodLabel %></strong></dd></div>
            <div><dt>fallback</dt><dd>現行保存形式では理由未保持</dd></div>
          </dl>
          <h3 class="payments-allocation-heading">参加者別負担額</h3>
          <ul class="payments-allocation-list payments-latest-allocation-list">
            <% latestBatch.allocations.forEach(allocation => { %><li><span><%= allocation.displayName %></span><strong><%= allocation.amount.toLocaleString("ja-JP") %> 円</strong></li><% }) %>
          </ul>
        <% } %>
      </aside>

      <section class="panel payments-history-panel" aria-labelledby="payment-history-heading">
        <div class="panel-heading payments-history-heading">
          <div><p class="eyebrow">確定済みTransaction</p><h2 id="payment-history-heading">関連支払い履歴</h2></div>
          <div class="payments-history-actions"><span><%= transactions.length %> 件</span><button type="button" class="payments-history-add" data-open-transaction-overlay="payments-transaction-overlay" aria-label="個別支払いを登録" title="個別支払いを登録">＋</button></div>
        </div>
        <div class="payments-history-tabs" role="tablist" aria-label="履歴表示方法">
          <button type="button" role="tab" id="payments-chronological-tab" aria-controls="payments-chronological-panel" aria-selected="true" tabindex="0" data-payment-tab="chronological">時系列</button>
          <button type="button" role="tab" id="payments-person-tab" aria-controls="payments-person-panel" aria-selected="false" tabindex="-1" data-payment-tab="person">人ごと</button>
        </div>
        <section id="payments-chronological-panel" role="tabpanel" aria-labelledby="payments-chronological-tab" data-payment-tab-panel="chronological">
          <div class="payments-ledger payments-ledger-chronological" aria-label="時系列の関連支払い履歴">
            <div class="payments-ledger-heading" aria-hidden="true"><span>日付</span><span>負担内容</span><span>金額</span><span>名前</span></div>
            <div class="payments-ledger-scroll" tabindex="0" aria-label="時系列履歴。上下にスクロールできます">
              <% if (transactions.length === 0) { %><p class="empty-state payments-history-empty">この期間には、まだ関連支払いがありません。</p><% } else { %>
                <% transactions.forEach(transaction => { %><article class="payments-ledger-row"><time datetime="<%= transaction.transactionDate.toISOString().slice(0, 10) %>"><%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %></time><span class="payments-ledger-text" tabindex="0" data-payment-tooltip="<%= transaction.rawText %>"><%= transaction.rawText %><% if (transaction.amount === 0 && transaction.paymentBatchId) { %><small>参加・負担0円</small><% } %></span><strong><%= transaction.amount.toLocaleString("ja-JP") %> 円</strong><span><%= transaction.user?.displayName ?? "不明なユーザー" %></span></article><% }) %>
              <% } %>
            </div>
            <div class="payments-ledger-total"><span>—</span><strong>総額</strong><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong><span>—</span></div>
          </div>
        </section>
        <section id="payments-person-panel" role="tabpanel" aria-labelledby="payments-person-tab" data-payment-tab-panel="person" hidden>
          <div class="payments-ledger payments-ledger-person" aria-label="人ごとの関連支払い集計">
            <div class="payments-ledger-heading" aria-hidden="true"><span>名前</span><span>合計支払額</span><span>支払い件数</span></div>
            <div class="payments-ledger-scroll" tabindex="0" aria-label="人ごとの集計。上下にスクロールできます">
              <% if (perPersonRows.length === 0) { %><p class="empty-state payments-history-empty">この期間に集計できる支払いがありません。</p><% } else { %><% perPersonRows.forEach(row => { %><article class="payments-ledger-row"><strong><%= row.displayName %></strong><strong><%= row.totalAmount.toLocaleString("ja-JP") %> 円</strong><span><%= row.paymentCount.toLocaleString("ja-JP") %> 件</span></article><% }) %><% } %>
            </div>
            <div class="payments-ledger-total"><strong>合計</strong><strong><%= historyTotal.toLocaleString("ja-JP") %> 円</strong><span><%= transactions.length.toLocaleString("ja-JP") %> 件</span></div>
          </div>
        </section>
      </section>
    </section>
  </main>

  <dialog
    class="payments-condition-dialog"
    aria-labelledby="payments-condition-title"
    aria-modal="true"
    data-payment-condition-dialog
    data-auto-open="<%= String(isCalculationMode && !preview && Boolean(error)) %>"
  >
    <section class="payments-condition-panel">
      <header class="payments-condition-header">
        <div>
          <p class="eyebrow">割り勘</p>
          <h2 id="payments-condition-title">支払い条件を入力</h2>
        </div>
        <button type="button" class="payments-dialog-close" data-close-payment-conditions aria-label="参加者と算出方法の選択へ戻る" title="参加者と算出方法の選択へ戻る">×</button>
      </header>

      <form id="split-preview-form" action="/groups/<%= group.id %>/payments/preview" method="post" class="payments-condition-form" data-split-preview-form>
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="open">

        <div class="payments-condition-body">
          <% if (error && isCalculationMode && !preview) { %>
            <p class="error-message payments-condition-error" role="alert"><%= error %></p>
          <% } %>

          <section class="payments-condition-selection" aria-label="選択済み条件">
            <div><span>算出方法</span><strong data-condition-method-label><%= selectedMethodOption?.label ?? "未選択" %></strong></div>
            <div><span>参加者</span><strong data-condition-participant-summary><%= splitDraft.participantIds.length %> 人</strong></div>
          </section>

          <div class="payments-condition-fields">
            <label>
              <span>支払い総額</span>
              <input type="number" name="totalAmount" min="1" step="1" value="<%= splitDraft.totalAmount %>" required inputmode="numeric">
            </label>
            <label>
              <span>実際の取引日</span>
              <input type="date" name="transactionDate" value="<%= splitDraft.transactionDate %>" max="<%= today %>" required>
            </label>
            <label class="payments-condition-wide">
              <span>内容・名目</span>
              <textarea name="rawText" maxlength="500" rows="5" required><%= splitDraft.rawText %></textarea>
            </label>
            <label class="payments-condition-wide">
              <span>カテゴリ</span>
              <select name="category" required>
                <option value="">選択してください</option>
                <% groupPaymentCategories.forEach(category => { %><option value="<%= category %>" <%= splitDraft.category === category ? "selected" : "" %>><%= category %></option><% }) %>
              </select>
            </label>
          </div>
          <p class="form-help">試算だけではDBへ保存されません。条件を変更した場合は、必ず再試算してください。</p>
        </div>

        <footer class="payments-condition-footer">
          <button type="button" class="secondary-button" data-close-payment-conditions>参加者・方式へ戻る</button>
          <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState: 'open' }) %>" class="secondary-button button-link">算出を中止</a>
          <button type="submit" class="primary-button" data-preview-submit disabled>負担額を試算</button>
        </footer>
      </form>
    </section>
  </dialog>

  <% if (preview) { %>
    <dialog class="payments-preview-dialog" aria-labelledby="payments-preview-title" aria-modal="true" data-payment-preview-dialog>
      <section class="payments-preview-panel">
        <header class="payments-preview-header"><div><p class="eyebrow">割り勘</p><h2 id="payments-preview-title">割り勘の試算結果</h2></div><span><%= preview.allocations.length %> 人</span></header>
        <div class="payments-preview-body">
          <dl class="payments-batch-definition payments-preview-definition">
            <div><dt>取引日</dt><dd><%= new Date(splitDraft.transactionDate + "T00:00:00Z").toLocaleDateString("ja-JP") %></dd></div>
            <div><dt>内容</dt><dd><span tabindex="0" data-payment-tooltip="<%= splitDraft.rawText %>"><%= splitDraft.rawText %></span></dd></div>
            <div><dt>カテゴリ</dt><dd><%= splitDraft.category %></dd></div>
            <div><dt>総額</dt><dd><strong><%= preview.totalAmount.toLocaleString("ja-JP") %> 円</strong></dd></div>
            <div><dt>選択方式</dt><dd><%= preview.selectedMethodLabel %></dd></div>
            <div><dt>実使用方式</dt><dd><strong><%= preview.usedMethodLabel %></strong></dd></div>
            <div><dt>fallback</dt><dd><%= preview.fallbackReason ?? "なし" %></dd></div>
          </dl>
          <% if (preview.fallbackReason) { %><p class="payments-fallback-message" role="status"><strong>均等割へfallback</strong><br><%= preview.fallbackReason %></p><% } %>
          <div class="payments-preview-table" role="table" aria-label="参加者別の試算結果">
            <div class="payments-preview-table__heading" role="row"><span role="columnheader">参加者</span><span role="columnheader">算出前比率</span><span role="columnheader">正確値</span><span role="columnheader">負担額</span></div>
            <div class="payments-preview-table__rows">
              <% preview.allocations.forEach(allocation => { %><div class="payments-preview-table__row" role="row"><strong role="cell"><%= allocation.displayName %></strong><span role="cell"><%= allocation.ratioPercent.toLocaleString("ja-JP", { maximumFractionDigits: 2 }) %>%</span><span role="cell"><%= allocation.exactAmount.toLocaleString("ja-JP", { minimumFractionDigits: 2, maximumFractionDigits: 4 }) %> 円</span><strong role="cell"><%= allocation.amount.toLocaleString("ja-JP") %> 円</strong></div><% }) %>
            </div>
            <div class="payments-preview-table__total"><span>合計</span><strong><%= preview.allocations.reduce((sum, allocation) => sum + allocation.amount, 0).toLocaleString("ja-JP") %> 円</strong></div>
          </div>
          <form id="split-confirm-form" action="/groups/<%= group.id %>/payments/confirm" method="post" hidden>
            <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>"><input type="hidden" name="contextState" value="open"><input type="hidden" name="totalAmount" value="<%= splitDraft.totalAmount %>"><input type="hidden" name="transactionDate" value="<%= splitDraft.transactionDate %>"><input type="hidden" name="rawText" value="<%= splitDraft.rawText %>"><input type="hidden" name="category" value="<%= splitDraft.category %>"><input type="hidden" name="calculationMethod" value="<%= splitDraft.calculationMethod %>"><input type="hidden" name="previewSignature" value="<%= previewSignature ?? '' %>"><% splitDraft.participantIds.forEach(participantId => { %><input type="hidden" name="participantIds" value="<%= participantId %>"><% }) %>
          </form>
          <p class="form-help" data-preview-stale-message hidden>条件を変更したため、この試算結果は古くなりました。もう一度試算してください。</p>
          <p class="form-help">この試算結果はまだDBへ保存されていません。</p>
        </div>
        <footer class="payments-preview-footer">
          <button type="button" class="secondary-button" data-edit-split-conditions>条件を修正</button>
          <button type="submit" form="split-confirm-form" class="primary-button" data-preview-confirm-button>確認へ進む</button>
          <a href="<%= buildGroupPaymentsUrl(group.id, { pageId: selectedPage.id, contextState: 'open' }) %>" class="secondary-button button-link" data-cancel-payment-preview>算出を中止</a>
        </footer>
      </section>
    </dialog>
  <% } %>

  <%- include("partials/transaction-add-overlay", {
    overlay: {
      id: "payments-transaction-overlay",
      mode: "GROUP_PAYMENT",
      eyebrow: "関連支払い",
      title: "個別支払いを追加",
      action: `/groups/${group.id}/payments/transactions`,
      groupId: group.id,
      today,
      placeholder: "例：昨日部活動の会場利用料を3000円払った",
      note: `${currentUserDisplayName}さん本人が、自分の財布から支払った金額として登録します。他人名義では登録できません。`,
      submitLabel: "個別支払いを登録",
      categories: groupPaymentCategories,
      hiddenFields: [
        { name: "currentPageId", value: selectedPage.id },
        { name: "contextState", value: contextState ?? "", contextHook: "data-payment-context-state" }
      ]
    }
  }) %>

  <% if (isAdmin) { %>
    <dialog class="payments-page-dialog" id="payments-page-add-dialog" aria-labelledby="payments-page-add-title">
      <form action="/groups/<%= group.id %>/payments/pages" method="post" class="page-form payments-dialog-form">
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>

        <div class="payments-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="payments-page-add-title">表示ページを追加</h2>
          </div>
          <button type="button" class="payments-dialog-close" data-close-payment-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate">
          </label>
        </div>

        <p class="form-help">日付を空欄にすると、その方向の期間を制限しません。</p>
        <div class="payments-dialog-actions">
          <button type="button" class="secondary-button" data-close-payment-dialog>キャンセル</button>
          <button type="submit" class="primary-button">ページを追加</button>
        </div>
      </form>
    </dialog>

    <dialog class="payments-page-dialog" id="payments-page-edit-dialog" aria-labelledby="payments-page-edit-title">
      <form action="/groups/<%= group.id %>/payments/pages/<%= selectedPage.id %>" method="post" class="page-form payments-dialog-form">
        <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>

        <div class="payments-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="payments-page-edit-title">選択中ページを編集</h2>
          </div>
          <button type="button" class="payments-dialog-close" data-close-payment-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" value="<%= selectedPage.name %>" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate" value="<%= selectedPageForm.startDate %>">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate" value="<%= selectedPageForm.endDate %>">
          </label>
        </div>

        <p class="form-help">初期ページも名前と期間を編集できます。初期ページの属性と削除不可状態は維持されます。</p>
        <div class="payments-dialog-actions">
          <button type="button" class="secondary-button" data-close-payment-dialog>キャンセル</button>
          <button type="submit" class="primary-button">変更を保存</button>
        </div>
      </form>
    </dialog>

    <form
      id="payments-delete-page-form"
      action="/groups/<%= group.id %>/payments/pages/<%= selectedPage.id %>/delete"
      method="post"
      class="payments-hidden-form"
      onsubmit="return confirm('選択中の表示ページを削除しますか？関連支払いTransaction自体は削除されません。');"
    >
      <input type="hidden" name="contextState" value="<%= contextState ?? '' %>" data-payment-context-state>
    </form>
  <% } %>

  <%- include("partials/ai-analysis-dialog", {
    analysisDialog: {
      id: "group-payment-ai-analysis-dialog",
      eyebrow: "関連支払い",
      title: "関連支払い分析",
      pageName: selectedPage.name,
    },
  }) %>

  <script>
    (() => {
      const lowerArea = document.querySelector("[data-payment-lower]");
      const toggle = document.querySelector("[data-payment-context-toggle]");
      const contextPanel = document.getElementById("payment-context-panel");
      const contextLinks = document.querySelectorAll("[data-payment-context-link]");
      const contextStateInputs = document.querySelectorAll("[data-payment-context-state]");

      const setContextOpen = (isOpen, persistInLinks = true) => {
        if (!(lowerArea instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(contextPanel instanceof HTMLElement)) return;

        lowerArea.classList.toggle("is-context-closed", !isOpen);
        lowerArea.dataset.contextState = isOpen ? "open" : "closed";
        const desktopIcon = toggle.querySelector("[data-operation-desktop-icon]");
        const mobileIcon = toggle.querySelector("[data-operation-mobile-icon]");
        const label = toggle.querySelector("[data-operation-label]");
        const isLocked = toggle.disabled;
        if (desktopIcon instanceof HTMLElement) desktopIcon.textContent = isOpen ? "←" : "→";
        if (mobileIcon instanceof HTMLElement) mobileIcon.textContent = isOpen ? "↑" : "↓";
        if (label instanceof HTMLElement) label.textContent = isLocked ? "算出中" : (isOpen ? "閉じる" : "開く");
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isLocked ? "算出中は参加者領域を閉じられません" : (isOpen ? "一覧を閉じる" : "一覧を開く"));
        toggle.setAttribute("title", isLocked ? "算出中は参加者領域を閉じられません" : (isOpen ? "一覧を閉じる" : "一覧を開く"));
        contextPanel.setAttribute("aria-hidden", String(!isOpen));

        const contextState = isOpen ? "open" : "closed";
        contextStateInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = contextState;
        });

        if (!persistInLinks) return;
        contextLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          url.searchParams.set("context", isOpen ? "open" : "closed");
          link.href = `${url.pathname}${url.search}${url.hash}`;
        });
      };

      if (lowerArea instanceof HTMLElement && toggle instanceof HTMLButtonElement && contextPanel instanceof HTMLElement) {
        const explicitState = lowerArea.dataset.contextState;
        const initialOpen = document.body.classList.contains("is-calculation-mode") || explicitState === "open";
        setContextOpen(initialOpen, explicitState === "open" || explicitState === "closed");
        toggle.addEventListener("click", () => setContextOpen(toggle.getAttribute("aria-expanded") !== "true"));
      }

      const body = document.body;
      const splitForm = document.querySelector("[data-split-preview-form]");
      const startSplitButton = document.querySelector("[data-start-split]");
      const calculationActions = document.querySelector("[data-calculation-actions]");
      const conditionOpenButton = document.querySelector("[data-open-payment-conditions]");
      const previewSubmit = document.querySelector("[data-preview-submit]");
      const participantInputs = [...document.querySelectorAll("[data-participant-input]")];
      const methodInputs = [...document.querySelectorAll("[data-calculation-method-input]")];
      const methodSummary = document.querySelector("[data-method-summary]");
      const previewConfirmButton = document.querySelector("[data-preview-confirm-button]");
      const previewStaleMessage = document.querySelector("[data-preview-stale-message]");
      const methodDescriptions = <%- JSON.stringify(Object.fromEntries(calculationMethodOptions.map(method => [method.value, method.description]))) %>;
      const methodLabels = <%- JSON.stringify(Object.fromEntries(calculationMethodOptions.map(method => [method.value, method.label]))) %>;

      const invalidateRenderedPreview = () => {
        if (!(previewConfirmButton instanceof HTMLButtonElement)) return;
        previewConfirmButton.disabled = true;
        previewConfirmButton.setAttribute("aria-disabled", "true");
        if (previewStaleMessage instanceof HTMLElement) previewStaleMessage.hidden = false;
      };

      const updateCalculationSelections = () => {
        participantInputs.forEach((input) => {
          const row = input.closest("[data-participant-row]");
          if (row) row.classList.toggle("is-selected", input.checked);
        });
        methodInputs.forEach((input) => {
          const row = input.closest("[data-calculation-method-row]");
          if (row) row.classList.toggle("is-selected", input.checked);
        });
        const selectedMethod = methodInputs.find((input) => input.checked);
        if (methodSummary) {
          methodSummary.textContent = selectedMethod
            ? methodDescriptions[selectedMethod.value]
            : "算出方法を選択してください。？を押すと、この欄に説明を表示します。";
        }
        window.dispatchEvent(new CustomEvent("payments:selection-updated", {
          detail: {
            methodLabel: selectedMethod ? methodLabels[selectedMethod.value] : "未選択",
            participantCount: participantInputs.filter((input) => input.checked).length,
          },
        }));
      };

      const updatePreviewAvailability = () => {
        if (!(splitForm instanceof HTMLFormElement) || !(previewSubmit instanceof HTMLButtonElement)) return;
        const hasParticipant = participantInputs.some((input) => input.checked);
        const hasMethod = methodInputs.some((input) => input.checked);
        if (conditionOpenButton instanceof HTMLButtonElement) {
          conditionOpenButton.disabled = !(hasParticipant && hasMethod);
        }
        previewSubmit.disabled = !(splitForm.checkValidity() && hasParticipant && hasMethod);
      };

      const enterCalculationMode = () => {
        body.classList.add("is-calculation-mode");
        body.dataset.calculationMode = "true";
        if (startSplitButton instanceof HTMLElement) startSplitButton.hidden = true;
        if (calculationActions instanceof HTMLElement) calculationActions.hidden = false;
        participantInputs.forEach((input) => { input.checked = true; });
        methodInputs.forEach((input) => { input.checked = false; });
        setContextOpen(true);
        if (toggle instanceof HTMLButtonElement) {
          toggle.disabled = true;
          toggle.setAttribute("aria-label", "算出中は参加者領域を閉じられません");
          toggle.setAttribute("title", "算出中は参加者領域を閉じられません");
        }
        updateCalculationSelections();
        updatePreviewAvailability();
        const firstMethod = methodInputs[0];
        if (firstMethod instanceof HTMLElement) firstMethod.focus();
      };

      startSplitButton?.addEventListener("click", enterCalculationMode);
      [...participantInputs, ...methodInputs].forEach((input) => {
        input.addEventListener("change", () => {
          updateCalculationSelections();
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
      });
      splitForm?.querySelectorAll("input, textarea, select").forEach((input) => {
        input.addEventListener("input", () => {
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
        input.addEventListener("change", () => {
          updatePreviewAvailability();
          invalidateRenderedPreview();
        });
      });
      if (body.classList.contains("is-calculation-mode")) {
        setContextOpen(true);
        if (toggle instanceof HTMLButtonElement) {
          toggle.disabled = true;
          toggle.setAttribute("aria-label", "算出中は参加者領域を閉じられません");
          toggle.setAttribute("title", "算出中は参加者領域を閉じられません");
        }
        updateCalculationSelections();
        updatePreviewAvailability();
      }

      const tabs = [...document.querySelectorAll("[data-payment-tab]")];
      const panels = [...document.querySelectorAll("[data-payment-tab-panel]")];
      const activateTab = (name, focus = false) => {
        tabs.forEach((tab) => {
          const selected = tab.getAttribute("data-payment-tab") === name;
          tab.setAttribute("aria-selected", String(selected));
          tab.setAttribute("tabindex", selected ? "0" : "-1");
          if (selected && focus && tab instanceof HTMLElement) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-payment-tab-panel") !== name;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(tab.getAttribute("data-payment-tab")));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const offset = event.key === "ArrowRight" ? 1 : -1;
          const next = tabs[(index + offset + tabs.length) % tabs.length];
          activateTab(next.getAttribute("data-payment-tab"), true);
        });
      });

      document.querySelectorAll("[data-method-help]").forEach((button) => {
        const showDescription = () => {
          if (!(methodSummary instanceof HTMLElement)) return;
          methodSummary.textContent = button.getAttribute("data-method-description") || "算出方法の説明を確認できませんでした。";
        };
        button.addEventListener("click", showDescription);
        button.addEventListener("pointerenter", showDescription);
        button.addEventListener("focus", showDescription);
      });

      document.querySelectorAll("[data-open-payment-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialogId = button.getAttribute("data-open-payment-dialog");
          const dialog = dialogId ? document.getElementById(dialogId) : null;
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      document.querySelectorAll("[data-close-payment-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = button.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      document.querySelectorAll(".payments-page-dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      const statusLabels = { EXPLICIT: "入力に明記", INFERRED: "AI・規則で推定", DEFAULTED: "画面の既定値", MISSING: "要入力" };
      document.querySelectorAll("[data-ai-classification-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;
        const button = form.querySelector("[data-ai-classify-button]");
        const rawText = form.elements.namedItem("rawText");
        const amount = form.elements.namedItem("amount");
        const date = form.elements.namedItem("transactionDate");
        const category = form.elements.namedItem("category");
        const token = form.querySelector("[data-ai-suggestion-token]");
        const panel = form.querySelector("[data-ai-suggestion-panel]");
        const message = form.querySelector("[data-ai-message]");
        const statuses = form.querySelector("[data-ai-field-status]");
        const warnings = form.querySelector("[data-ai-warnings]");
        button?.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement) || !(rawText instanceof HTMLTextAreaElement)) return;
          const text = rawText.value.trim();
          if (!text) { rawText.setCustomValidity("AIで推定する内容を入力してください。"); rawText.reportValidity(); rawText.setCustomValidity(""); return; }
          button.disabled = true; button.textContent = "推定中…"; form.setAttribute("aria-busy", "true");
          if (panel instanceof HTMLElement) panel.hidden = false;
          if (message instanceof HTMLElement) message.textContent = "AIで候補を作成しています。";
          try {
            const response = await fetch("/api/ai/classify-transaction", {
              method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, credentials: "same-origin",
              body: JSON.stringify({ target: form.dataset.aiTarget, groupId: Number(form.dataset.aiGroupId), rawText: text }),
            });
            const payload = await response.json().catch(() => null);
            if (!payload?.suggestion) throw new Error(payload?.message || "AI候補を取得できませんでした。");
            const suggestion = payload.suggestion;
            if (amount instanceof HTMLInputElement && suggestion.amount !== null) amount.value = String(suggestion.amount);
            if (date instanceof HTMLInputElement) date.value = suggestion.transactionDate || payload.referenceDate || date.value;
            if (category instanceof HTMLSelectElement) category.value = suggestion.category || "";
            if (payload.source === "AI" && suggestion.summary) rawText.value = suggestion.summary;
            if (token instanceof HTMLInputElement) token.value = payload.suggestionToken || "";
            if (message instanceof HTMLElement) { message.textContent = payload.message || "候補を表示しました。"; message.dataset.source = payload.source || ""; }
            if (statuses instanceof HTMLElement) {
              statuses.replaceChildren();
              [["種類", suggestion.fieldStatus?.transactionType], ["金額", suggestion.fieldStatus?.amount], ["取引日", suggestion.transactionDate ? suggestion.fieldStatus?.transactionDate : "DEFAULTED"], ["カテゴリ", suggestion.fieldStatus?.category]].forEach(([label, status]) => {
                const dt = document.createElement("dt"); dt.textContent = label;
                const dd = document.createElement("dd"); dd.textContent = statusLabels[status] || "要確認"; dd.dataset.status = status || "";
                statuses.append(dt, dd);
              });
            }
            if (warnings instanceof HTMLUListElement) {
              warnings.replaceChildren();
              (Array.isArray(suggestion.warnings) ? suggestion.warnings : []).forEach((value) => { const li = document.createElement("li"); li.textContent = String(value); warnings.append(li); });
              warnings.hidden = warnings.children.length === 0;
            }
          } catch (error) {
            if (message instanceof HTMLElement) { message.textContent = error instanceof Error ? error.message : "AI候補を取得できませんでした。"; message.dataset.source = "ERROR"; }
          } finally { button.disabled = false; button.textContent = "AIで推定"; form.removeAttribute("aria-busy"); }
        });
      });

      document.querySelectorAll("form[method='post']").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (event.defaultPrevented) return;

          if (form.dataset.submitting === "true") {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          form.dataset.submitting = "true";
          form.setAttribute("aria-busy", "true");
          const submitControls = [
            ...form.querySelectorAll("button[type='submit'], input[type='submit']"),
            ...(form.id
              ? document.querySelectorAll(`button[type="submit"][form="${form.id}"], input[type="submit"][form="${form.id}"]`)
              : []),
          ];
          submitControls.forEach((control) => {
            if (control instanceof HTMLButtonElement) {
              control.textContent = "処理中…";
              control.disabled = true;
            } else if (control instanceof HTMLInputElement) {
              control.value = "処理中…";
              control.disabled = true;
            }
          });
        });
      });

      const tooltip = document.createElement("div");
      tooltip.className = "payments-tooltip";
      tooltip.setAttribute("role", "tooltip");
      tooltip.hidden = true;
      document.body.append(tooltip);

      const hideTooltip = () => {
        tooltip.hidden = true;
        tooltip.textContent = "";
      };
      const showTooltip = (target) => {
        if (!(target instanceof HTMLElement)) return;
        const text = target.dataset.paymentTooltip;
        if (!text || target.scrollWidth <= target.clientWidth) {
          hideTooltip();
          return;
        }
        tooltip.textContent = text;
        tooltip.hidden = false;
        const rect = target.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const padding = 12;
        let left = Math.max(padding, Math.min(rect.left, window.innerWidth - tooltipRect.width - padding));
        let top = rect.bottom + 8;
        if (top + tooltipRect.height > window.innerHeight - padding) top = Math.max(padding, rect.top - tooltipRect.height - 8);
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${top}px`;
      };
      document.querySelectorAll("[data-payment-tooltip]").forEach((target) => {
        target.addEventListener("mouseenter", () => showTooltip(target));
        target.addEventListener("mouseleave", hideTooltip);
        target.addEventListener("focus", () => showTooltip(target));
        target.addEventListener("blur", hideTooltip);
        target.addEventListener("click", () => tooltip.hidden ? showTooltip(target) : hideTooltip());
      });
      window.addEventListener("resize", hideTooltip);
      window.addEventListener("scroll", hideTooltip, { passive: true, capture: true });
    })();
  </script>
  <script src="/js/payment-charts.js" defer></script>
  <script src="/js/payment-condition-overlay.js" defer></script>
  <% if (preview) { %><script src="/js/payment-preview-overlay.js" defer></script><% } %>
  <script src="/js/transaction-overlay.js" defer></script>
  <script src="/js/ai-analysis-dialog.js" defer></script>
</body>
</html>
