DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/my_app_v2_dev?sslmode=require"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/my_app_v2_shadow?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
NODE_ENV="development"

# OpenAI server-side settings. Never expose these values to browser code.
OPENAI_API_KEY=""
OPENAI_CLASSIFICATION_MODEL="gpt-5.4-nano"
OPENAI_ANALYSIS_MODEL="gpt-5.4-mini"
AI_FEATURE_ENABLED="true"
AI_CLASSIFICATION_ENABLED="true"
AI_ANALYSIS_ENABLED="true"
AI_SAFETY_SALT="replace-with-a-long-random-secret"

# Timeout and retry settings (milliseconds).
AI_CLASSIFICATION_TIMEOUT_MS="10000"
AI_CLASSIFICATION_FIRST_ATTEMPT_TIMEOUT_MS="6000"
AI_ANALYSIS_TIMEOUT_MS="20000"
AI_ANALYSIS_FIRST_ATTEMPT_TIMEOUT_MS="12000"
AI_RETRY_BASE_DELAY_MS="250"
AI_RETRY_JITTER_MS="150"
AI_CLASSIFICATION_MAX_OUTPUT_TOKENS="500"
AI_ANALYSIS_MAX_OUTPUT_TOKENS="1200"

# In-memory abuse prevention. Counters reset when the server restarts and are
# not shared between multiple application instances.
AI_CLASSIFICATION_USER_MINUTE_LIMIT="5"
AI_CLASSIFICATION_USER_DAILY_LIMIT="10"
AI_CLASSIFICATION_GLOBAL_MINUTE_LIMIT="20"
AI_CLASSIFICATION_GLOBAL_DAILY_LIMIT="100"
AI_ANALYSIS_USER_MINUTE_LIMIT="1"
AI_ANALYSIS_USER_DAILY_LIMIT="3"
AI_ANALYSIS_GLOBAL_MINUTE_LIMIT="5"
AI_ANALYSIS_GLOBAL_DAILY_LIMIT="30"
