<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= fund.name %> - <%= selectedPage.name %></title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/ledger.css">
  <link rel="stylesheet" href="/css/group.css">
  <link rel="stylesheet" href="/css/fund.css">
</head>
<body class="ledger-body fund-body">
  <header class="ledger-header">
    <div>
      <p class="eyebrow">グループ基金</p>
      <h1><%= fund.name %></h1>
      <p class="period-label">
        <strong><%= selectedPage.name %></strong>：
        <% if (selectedPage.startDate || selectedPage.endDate) { %>
          <%= selectedPage.startDate ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
          〜
          <%= selectedPage.endDate ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP") : "期間指定なし" %>
        <% } else { %>
          全期間
        <% } %>
      </p>
    </div>

    <nav class="header-actions group-header-nav" aria-label="グループ画面ナビゲーション">
      <a href="/app" class="secondary-button button-link group-nav-item">自分の家計簿</a>
      <a href="/groups/<%= group.id %>" class="secondary-button button-link group-nav-item">概要</a>
      <a
        href="<%= buildGroupFundUrl(group.id, { pageId: selectedPage.id, contextState }) %>"
        class="secondary-button button-link group-nav-item is-active"
        data-fund-context-link
        aria-current="page"
      >
        基金
      </a>
      <span
        class="secondary-button button-link group-nav-item is-disabled"
        aria-disabled="true"
        title="関連支払いは未実装です"
      >
        関連支払い
      </span>
      <form action="/logout" method="post" class="group-nav-logout">
        <button type="submit" class="secondary-button group-nav-item">ログアウト</button>
      </form>
    </nav>
  </header>

  <% if (error || success) { %>
    <section class="flash-area" aria-live="polite">
      <% if (error) { %>
        <p class="error-message" role="alert"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="success-message" role="status"><%= success %></p>
      <% } %>
    </section>
  <% } %>

  <section class="summary-grid" aria-label="基金収支サマリー">
    <article class="summary-card">
      <span>繰越金</span>
      <strong><%= summary.carryover.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card income-card">
      <span>基金収入</span>
      <strong><%= summary.incomeTotal.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card expense-card">
      <span>基金支出</span>
      <strong><%= summary.expenseTotal.toLocaleString("ja-JP") %> 円</strong>
    </article>
    <article class="summary-card balance-card">
      <span>基金残高</span>
      <strong><%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
    </article>
  </section>

  <main class="fund-layout<%= isContextOpen ? '' : ' is-context-closed' %>" data-fund-layout>
    <aside
      class="fund-context-column"
      id="fund-context-panel"
      aria-label="基金ページと有効メンバー"
      aria-hidden="<%= String(!isContextOpen) %>"
    >
      <section class="panel fund-page-panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">期間</p>
            <h2>表示ページ</h2>
          </div>
          <span><%= pages.length %> 件</span>
        </div>

        <nav class="page-list" aria-label="グループ基金ページ">
          <% pages.forEach(page => { %>
            <a
              href="<%= buildGroupFundUrl(group.id, { pageId: page.id, contextState }) %>"
              class="<%= page.id === selectedPage.id ? 'is-active' : '' %>"
              data-fund-context-link
              <% if (page.id === selectedPage.id) { %>aria-current="page"<% } %>
            >
              <span>
                <strong><%= page.name %></strong>
                <small>
                  <% if (page.startDate || page.endDate) { %>
                    <%= page.startDate ? new Date(page.startDate).toLocaleDateString("ja-JP") : "指定なし" %>
                    〜
                    <%= page.endDate ? new Date(page.endDate).toLocaleDateString("ja-JP") : "指定なし" %>
                  <% } else { %>
                    全期間
                  <% } %>
                </small>
              </span>
              <% if (page.isInitial) { %><small class="initial-badge">初期</small><% } %>
            </a>
          <% }) %>
        </nav>

        <p class="form-help fund-stage-note">
          LedgerPage管理はグループ管理者だけが行えます。
        </p>
      </section>

      <section class="panel fund-member-panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">閲覧専用</p>
            <h2>有効メンバー</h2>
          </div>
          <span><%= activeMembers.length %> 人</span>
        </div>

        <ul class="fund-member-list">
          <% activeMembers.forEach(member => { %>
            <li>
              <span>
                <strong><%= member.user.displayName %></strong>
                <% if (member.userId === currentUserId) { %><small>あなた</small><% } %>
              </span>
              <small><%= member.role === "ADMIN" ? "管理者" : "メンバー" %></small>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="panel fund-status-panel">
        <p class="eyebrow">基金状態</p>
        <dl class="group-definition-list">
          <div>
            <dt>基金名</dt>
            <dd><%= fund.name %></dd>
          </div>
          <div>
            <dt>状態</dt>
            <dd><%= fund.isActive ? "有効" : "無効" %></dd>
          </div>
          <div>
            <dt>自分の権限</dt>
            <dd><%= membership.role === "ADMIN" ? "グループ管理者" : "メンバー" %></dd>
          </div>
        </dl>
      </section>
    </aside>

    <aside class="fund-operation-rail" aria-label="LedgerPage操作">
      <button
        type="button"
        class="fund-context-toggle"
        data-fund-context-toggle
        aria-controls="fund-context-panel"
        aria-expanded="<%= String(isContextOpen) %>"
        aria-label="<%= isContextOpen ? '左領域を閉じる' : '左領域を開く' %>"
        title="<%= isContextOpen ? '左領域を閉じる' : '左領域を開く' %>"
      ><%= isContextOpen ? '←' : '→' %></button>
      <button
        type="button"
        data-open-dialog="fund-page-edit-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? '選択中LedgerPageを編集' : 'LedgerPage編集はグループ管理者のみ可能です' %>"
      >⚙</button>
      <button
        type="button"
        data-open-dialog="fund-page-add-dialog"
        <%= isAdmin ? "" : "disabled" %>
        aria-label="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
        title="<%= isAdmin ? 'LedgerPageを追加' : 'LedgerPage追加はグループ管理者のみ可能です' %>"
      >＋</button>
      <button
        type="submit"
        form="fund-delete-page-form"
        <%= !isAdmin || selectedPage.isInitial ? "disabled" : "" %>
        aria-label="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
        title="<%= !isAdmin ? 'LedgerPage削除はグループ管理者のみ可能です' : selectedPage.isInitial ? '初期LedgerPageは削除できません' : '選択中LedgerPageを削除' %>"
      >−</button>
    </aside>

    <aside class="panel fund-collapsed-column" aria-hidden="true">
      <p class="eyebrow">期間サマリー</p>
      <h2><%= selectedPage.name %></h2>
      <p class="fund-collapsed-balance">
        基金残高
        <strong><%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
      </p>
      <p class="form-help">左の右矢印から、LedgerPage一覧と有効メンバー一覧を開けます。</p>
    </aside>

    <section class="panel transaction-panel fund-transaction-panel">
      <% const kindLabels = {
        FUND_CONTRIBUTION: "基金拠出",
        FUND_INCOME: "基金収入",
        FUND_EXPENSE: "基金支出",
        FUND_REFUND: "基金返金"
      }; %>
      <% const sourceLabels = { MANUAL: "手動", KEYWORD: "キーワード", AI: "AI" }; %>
      <% const carryoverIsIncomeSide = summary.carryover >= 0; %>
      <% const balanceIsIncomeSide = summary.balance >= 0; %>
      <% const carryoverDateLabel = selectedPage.startDate
        ? new Date(selectedPage.startDate).toLocaleDateString("ja-JP")
        : "開始時"; %>
      <% const balanceDateLabel = selectedPage.endDate
        ? new Date(selectedPage.endDate).toLocaleDateString("ja-JP")
        : "現在"; %>

      <div class="panel-heading fund-history-heading">
        <div>
          <p class="eyebrow">詳細</p>
          <h2>基金取引履歴</h2>
        </div>
        <div class="fund-history-actions">
          <span><%= transactions.length %> 件</span>
          <button
            type="button"
            class="fund-history-add"
            data-open-dialog="fund-transaction-type-dialog"
            <%= canCreateFundTransaction ? "" : "disabled" %>
            aria-label="<%= canCreateFundTransaction ? '基金取引を追加' : '無効な基金には取引を追加できません' %>"
            title="<%= canCreateFundTransaction ? '基金取引を追加' : '無効な基金には取引を追加できません' %>"
          >＋</button>
        </div>
      </div>

      <div class="fund-ledger" aria-label="基金収入と基金支出の取引台帳">
        <div class="fund-ledger-column-heading" role="row">
          <span role="columnheader">日付</span>
          <span role="columnheader">内容</span>
          <span role="columnheader">金額</span>
          <span role="columnheader">内容</span>
          <span role="columnheader">金額</span>
        </div>

        <section class="fund-ledger-section fund-ledger-carryover" aria-label="繰越金">
          <div class="fund-ledger-row fund-ledger-summary-row">
            <time title="<%= carryoverDateLabel %>"><%= carryoverDateLabel %></time>
            <% if (carryoverIsIncomeSide) { %>
              <div class="fund-ledger-content-cell"><strong>繰越金</strong></div>
              <strong class="fund-ledger-amount income-text">+<%= summary.carryover.toLocaleString("ja-JP") %> 円</strong>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
            <% } else { %>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-content-cell"><strong>繰越金</strong></div>
              <strong class="fund-ledger-amount expense-text">−<%= Math.abs(summary.carryover).toLocaleString("ja-JP") %> 円</strong>
            <% } %>
          </div>
        </section>

        <section class="fund-ledger-section fund-ledger-transactions" aria-label="取引詳細">
          <div class="fund-ledger-scroll" tabindex="0" aria-label="基金取引詳細。上下にスクロールできます">
            <% if (transactions.length === 0) { %>
              <p class="empty-state fund-ledger-empty-state">この期間には、まだ基金取引がありません。</p>
            <% } else { %>
              <% transactions.forEach(transaction => { %>
                <% const isIncomeTransaction = transaction.kind === "FUND_CONTRIBUTION" || transaction.kind === "FUND_INCOME"; %>
                <% const relationLabel = transaction.user
                  ? transaction.user.displayName
                  : transaction.kind === "FUND_INCOME"
                    ? "外部収入"
                    : transaction.kind === "FUND_REFUND"
                      ? "外部・関係者なし"
                      : "関係者なし"; %>
                <article class="fund-ledger-row fund-ledger-transaction-row">
                  <time
                    datetime="<%= new Date(transaction.transactionDate).toISOString().slice(0, 10) %>"
                    title="<%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %>"
                  >
                    <%= new Date(transaction.transactionDate).toLocaleDateString("ja-JP") %>
                  </time>

                  <% if (isIncomeTransaction) { %>
                    <% const transactionMeta = `${kindLabels[transaction.kind]}・${relationLabel}・${transaction.category}・${sourceLabels[transaction.classificationSource]}`; %>
                    <div class="fund-ledger-content-cell">
                      <strong class="fund-ledger-primary-text" data-ledger-tooltip="<%= transaction.rawText %>" aria-label="<%= transaction.rawText %>"><%= transaction.rawText %></strong>
                      <small class="fund-ledger-meta" data-ledger-tooltip="<%= transactionMeta %>" aria-label="<%= transactionMeta %>"><%= transactionMeta %></small>
                    </div>
                    <strong class="fund-ledger-amount income-text">+<%= transaction.amount.toLocaleString("ja-JP") %> 円</strong>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                  <% } else { %>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
                    <% const transactionMeta = `${kindLabels[transaction.kind]}・${relationLabel}・${transaction.category}・${sourceLabels[transaction.classificationSource]}`; %>
                    <div class="fund-ledger-content-cell">
                      <strong class="fund-ledger-primary-text" data-ledger-tooltip="<%= transaction.rawText %>" aria-label="<%= transaction.rawText %>"><%= transaction.rawText %></strong>
                      <small class="fund-ledger-meta" data-ledger-tooltip="<%= transactionMeta %>" aria-label="<%= transactionMeta %>"><%= transactionMeta %></small>
                    </div>
                    <strong class="fund-ledger-amount expense-text">−<%= transaction.amount.toLocaleString("ja-JP") %> 円</strong>
                  <% } %>
                </article>
              <% }) %>
            <% } %>
          </div>
        </section>

        <section class="fund-ledger-section fund-ledger-balance" aria-label="残高">
          <div class="fund-ledger-row fund-ledger-summary-row">
            <time title="<%= balanceDateLabel %>"><%= balanceDateLabel %></time>
            <% if (balanceIsIncomeSide) { %>
              <div class="fund-ledger-content-cell"><strong>残高</strong></div>
              <strong class="fund-ledger-amount income-text">+<%= summary.balance.toLocaleString("ja-JP") %> 円</strong>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
            <% } else { %>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-empty-cell" aria-hidden="true"></div>
              <div class="fund-ledger-content-cell"><strong>残高</strong></div>
              <strong class="fund-ledger-amount expense-text">−<%= Math.abs(summary.balance).toLocaleString("ja-JP") %> 円</strong>
            <% } %>
          </div>
        </section>
      </div>
    </section>
  </main>


  <% if (isAdmin) { %>
    <dialog class="fund-page-dialog" id="fund-page-add-dialog" aria-labelledby="fund-page-add-title">
      <form action="/groups/<%= group.id %>/fund/pages" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-add-title">表示ページを追加</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate">
          </label>
        </div>

        <p class="form-help">日付を空欄にすると、その方向の期間を制限しません。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">ページを追加</button>
        </div>
      </form>
    </dialog>

    <dialog class="fund-page-dialog" id="fund-page-edit-dialog" aria-labelledby="fund-page-edit-title">
      <form action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>" method="post" class="page-form fund-dialog-form">
        <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
        <div class="fund-dialog-heading">
          <div>
            <p class="eyebrow">LedgerPage管理</p>
            <h2 id="fund-page-edit-title">選択中ページを編集</h2>
          </div>
          <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
        </div>

        <label>
          <span>ページ名</span>
          <input type="text" name="name" value="<%= selectedPage.name %>" maxlength="100" required>
        </label>

        <div class="date-pair">
          <label>
            <span>開始日</span>
            <input type="date" name="startDate" value="<%= selectedPageForm.startDate %>">
          </label>
          <label>
            <span>終了日</span>
            <input type="date" name="endDate" value="<%= selectedPageForm.endDate %>">
          </label>
        </div>

        <p class="form-help">初期ページも名前と期間は編集できます。初期ページの属性と削除不可状態は維持されます。</p>
        <div class="fund-dialog-actions">
          <button type="button" class="secondary-button" data-close-dialog>キャンセル</button>
          <button type="submit" class="primary-button">変更を保存</button>
        </div>
      </form>
    </dialog>

    <form
      id="fund-delete-page-form"
      action="/groups/<%= group.id %>/fund/pages/<%= selectedPage.id %>/delete"
      method="post"
      class="fund-hidden-form"
      onsubmit="return confirm('選択中の表示ページを削除しますか？基金Transaction自体は削除されません。');"
    >
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>
    </form>
  <% } %>

  <dialog class="fund-page-dialog" id="fund-transaction-type-dialog" aria-labelledby="fund-transaction-type-title">
    <div class="fund-dialog-form">
      <div class="fund-dialog-heading">
        <div>
          <p class="eyebrow">基金Transaction</p>
          <h2 id="fund-transaction-type-title">追加する取引を選択</h2>
        </div>
        <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
      </div>

      <div class="fund-transaction-type-list">
        <button type="button" class="fund-transaction-type-option" data-switch-dialog="fund-income-dialog">
          <strong>基金収入</strong>
          <span>外部寄付、助成金、イベント収益などを登録します。</span>
        </button>
        <button type="button" class="fund-transaction-type-option" data-switch-dialog="fund-contribution-dialog">
          <strong>自分が基金へ拠出</strong>
          <span>あなた個人の財布から、このグループ基金へ拠出します。</span>
        </button>
        <button type="button" class="fund-transaction-type-option" data-switch-dialog="fund-expense-dialog">
          <strong>基金支出</strong>
          <span>備品費、会場費、交通費、飲食費、活動費などを登録します。</span>
        </button>
        <button type="button" class="fund-transaction-type-option" disabled>
          <strong>基金返金</strong>
          <span>第6-3-4で実装します。</span>
        </button>
      </div>
    </div>
  </dialog>

  <dialog class="fund-page-dialog" id="fund-contribution-dialog" aria-labelledby="fund-contribution-title">
    <form action="/groups/<%= group.id %>/fund/transactions/contribution" method="post" class="page-form fund-dialog-form">
      <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>

      <div class="fund-dialog-heading">
        <div>
          <p class="eyebrow">基金Transaction</p>
          <h2 id="fund-contribution-title">基金へ拠出</h2>
        </div>
        <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
      </div>

      <p class="form-help">拠出者はログイン中のあなた本人です。ほかのメンバー名義では登録できません。</p>

      <label>
        <span>実際の取引日</span>
        <input type="date" name="transactionDate" value="<%= today %>" required>
      </label>

      <label>
        <span>金額</span>
        <input type="number" name="amount" min="1" step="1" inputmode="numeric" required>
      </label>

      <label>
        <span>内容</span>
        <textarea name="rawText" rows="4" maxlength="500" placeholder="例：7月分の基金拠出" required></textarea>
      </label>

      <p class="form-help">この1件を、基金側では収入、あなたの個人家計簿では支出として表示します。</p>
      <div class="fund-dialog-actions">
        <button type="button" class="secondary-button" data-switch-dialog="fund-transaction-type-dialog">取引種別へ戻る</button>
        <button type="submit" class="primary-button">基金へ拠出</button>
      </div>
    </form>
  </dialog>

  <dialog class="fund-page-dialog" id="fund-income-dialog" aria-labelledby="fund-income-title">
    <form action="/groups/<%= group.id %>/fund/transactions/income" method="post" class="page-form fund-dialog-form">
      <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>

      <div class="fund-dialog-heading">
        <div>
          <p class="eyebrow">基金Transaction</p>
          <h2 id="fund-income-title">基金収入を登録</h2>
        </div>
        <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
      </div>

      <label>
        <span>実際の取引日</span>
        <input type="date" name="transactionDate" required>
      </label>

      <label>
        <span>金額</span>
        <input type="number" name="amount" min="1" step="1" inputmode="numeric" required>
      </label>

      <label>
        <span>内容</span>
        <textarea name="rawText" rows="4" maxlength="500" required></textarea>
      </label>

      <label>
        <span>カテゴリ</span>
        <select name="category" required>
          <option value="">選択してください</option>
          <% fundIncomeCategories.forEach(category => { %>
            <option value="<%= category %>"><%= category %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>関係者</span>
        <select name="relatedUserId">
          <option value="">外部・関係者なし</option>
          <% activeMembers.forEach(member => { %>
            <option value="<%= member.userId %>">
              <%= member.user.displayName %><%= member.userId === currentUserId ? "（あなた）" : "" %>
            </option>
          <% }) %>
        </select>
      </label>

      <p class="form-help">個人からの基金拠出は「自分が基金へ拠出」から登録してください。</p>
      <div class="fund-dialog-actions">
        <button type="button" class="secondary-button" data-switch-dialog="fund-transaction-type-dialog">取引種別へ戻る</button>
        <button type="submit" class="primary-button">基金収入を登録</button>
      </div>
    </form>
  </dialog>

  <dialog class="fund-page-dialog" id="fund-expense-dialog" aria-labelledby="fund-expense-title">
    <form action="/groups/<%= group.id %>/fund/transactions/expense" method="post" class="page-form fund-dialog-form">
      <input type="hidden" name="currentPageId" value="<%= selectedPage.id %>">
      <input type="hidden" name="contextState" value="<%= contextState %>" data-fund-context-state>

      <div class="fund-dialog-heading">
        <div>
          <p class="eyebrow">基金Transaction</p>
          <h2 id="fund-expense-title">基金支出を登録</h2>
        </div>
        <button type="button" class="fund-dialog-close" data-close-dialog aria-label="閉じる" title="閉じる">×</button>
      </div>

      <label>
        <span>実際の取引日</span>
        <input type="date" name="transactionDate" required>
      </label>

      <label>
        <span>金額</span>
        <input type="number" name="amount" min="1" step="1" inputmode="numeric" required>
      </label>

      <label>
        <span>内容</span>
        <textarea name="rawText" rows="4" maxlength="500" required></textarea>
      </label>

      <label>
        <span>カテゴリ</span>
        <select name="category" required>
          <option value="">選択してください</option>
          <% fundExpenseCategories.forEach(category => { %>
            <option value="<%= category %>"><%= category %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>関係者</span>
        <select name="relatedUserId">
          <option value="">外部・関係者なし</option>
          <% activeMembers.forEach(member => { %>
            <option value="<%= member.userId %>">
              <%= member.user.displayName %><%= member.userId === currentUserId ? "（あなた）" : "" %>
            </option>
          <% }) %>
        </select>
      </label>

      <p class="form-help">備品購入、会場費、活動費、立替補填など、基金の通常支出として登録します。</p>
      <div class="fund-dialog-actions">
        <button type="button" class="secondary-button" data-switch-dialog="fund-transaction-type-dialog">取引種別へ戻る</button>
        <button type="submit" class="primary-button">基金支出を登録</button>
      </div>
    </form>
  </dialog>

  <script>
    (() => {
      const layout = document.querySelector("[data-fund-layout]");
      const toggle = document.querySelector("[data-fund-context-toggle]");
      const context = document.getElementById("fund-context-panel");
      const stateInputs = document.querySelectorAll("[data-fund-context-state]");
      const stateLinks = document.querySelectorAll("[data-fund-context-link]");

      if (!layout || !toggle || !context) return;

      const setOpen = (isOpen) => {
        layout.classList.toggle("is-context-closed", !isOpen);
        toggle.textContent = isOpen ? "←" : "→";
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isOpen ? "左領域を閉じる" : "左領域を開く");
        toggle.setAttribute("title", isOpen ? "左領域を閉じる" : "左領域を開く");
        context.setAttribute("aria-hidden", String(!isOpen));

        const contextState = isOpen ? "open" : "closed";
        stateInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = contextState;
        });
        stateLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          if (isOpen) {
            url.searchParams.set("context", "open");
          } else {
            url.searchParams.delete("context");
          }
          link.href = `${url.pathname}${url.search}${url.hash}`;
        });
      };

      // 初回は閉状態。POST後やページ切替後は、直前の開閉状態を復元する。
      setOpen(toggle.getAttribute("aria-expanded") === "true");

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      // 取引詳細の縦スクロールバー幅を、見出し・繰越金・残高へ同期する。
      const fundLedger = document.querySelector(".fund-ledger");
      const fundLedgerScroll = document.querySelector(".fund-ledger-scroll");
      const syncFundLedgerScrollbar = () => {
        if (!(fundLedger instanceof HTMLElement) || !(fundLedgerScroll instanceof HTMLElement)) return;
        const scrollbarWidth = Math.max(0, fundLedgerScroll.offsetWidth - fundLedgerScroll.clientWidth);
        fundLedger.style.setProperty("--fund-ledger-scrollbar-width", `${scrollbarWidth}px`);
      };

      requestAnimationFrame(syncFundLedgerScrollbar);
      window.addEventListener("resize", syncFundLedgerScrollbar);
      if ("ResizeObserver" in window && fundLedgerScroll instanceof HTMLElement) {
        const ledgerResizeObserver = new ResizeObserver(syncFundLedgerScrollbar);
        ledgerResizeObserver.observe(fundLedgerScroll);
      }

      // 省略された取引内容は、スクロール領域に切られない独自ツールチップで全文表示する。
      const ledgerTooltip = document.createElement("div");
      ledgerTooltip.className = "fund-ledger-tooltip";
      ledgerTooltip.setAttribute("role", "tooltip");
      ledgerTooltip.hidden = true;
      document.body.append(ledgerTooltip);

      let activeTooltipTarget = null;

      const hideLedgerTooltip = () => {
        ledgerTooltip.hidden = true;
        ledgerTooltip.textContent = "";
        activeTooltipTarget = null;
      };

      const showLedgerTooltip = (target) => {
        if (!(target instanceof HTMLElement)) return;
        const fullText = target.dataset.ledgerTooltip;
        if (!fullText || target.scrollWidth <= target.clientWidth) {
          hideLedgerTooltip();
          return;
        }

        ledgerTooltip.textContent = fullText;
        ledgerTooltip.hidden = false;
        activeTooltipTarget = target;

        const targetRect = target.getBoundingClientRect();
        const tooltipRect = ledgerTooltip.getBoundingClientRect();
        const viewportPadding = 12;
        const gap = 8;

        let left = targetRect.left;
        left = Math.min(left, window.innerWidth - tooltipRect.width - viewportPadding);
        left = Math.max(viewportPadding, left);

        let top = targetRect.bottom + gap;
        if (top + tooltipRect.height > window.innerHeight - viewportPadding) {
          top = Math.max(viewportPadding, targetRect.top - tooltipRect.height - gap);
        }

        ledgerTooltip.style.left = `${left}px`;
        ledgerTooltip.style.top = `${top}px`;
      };

      document.querySelectorAll("[data-ledger-tooltip]").forEach((target) => {
        target.addEventListener("mouseenter", () => showLedgerTooltip(target));
        target.addEventListener("mouseleave", hideLedgerTooltip);
      });

      fundLedgerScroll?.addEventListener("scroll", hideLedgerTooltip, { passive: true });
      window.addEventListener("resize", hideLedgerTooltip);
      window.addEventListener("scroll", hideLedgerTooltip, { passive: true, capture: true });

      document.querySelectorAll("[data-open-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialogId = button.getAttribute("data-open-dialog");
          const dialog = dialogId ? document.getElementById(dialogId) : null;
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      document.querySelectorAll("[data-switch-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const currentDialog = button.closest("dialog");
          const nextDialogId = button.getAttribute("data-switch-dialog");
          const nextDialog = nextDialogId ? document.getElementById(nextDialogId) : null;

          if (currentDialog instanceof HTMLDialogElement) currentDialog.close();
          if (nextDialog instanceof HTMLDialogElement) nextDialog.showModal();
        });
      });

      document.querySelectorAll("[data-close-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = button.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      document.querySelectorAll("dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });

      // DB更新フォームは最初の有効なsubmitで即時ロックし、連打による重複登録を防ぐ。
      document.querySelectorAll("form[method='post']").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (event.defaultPrevented) return;

          if (form.dataset.submitting === "true") {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          form.dataset.submitting = "true";
          form.setAttribute("aria-busy", "true");

          form.querySelectorAll("button[type='submit'], input[type='submit']").forEach((control) => {
            if (control instanceof HTMLButtonElement) {
              control.dataset.originalText = control.textContent ?? "";
              control.textContent = "処理中…";
              control.disabled = true;
            } else if (control instanceof HTMLInputElement) {
              control.dataset.originalValue = control.value;
              control.value = "処理中…";
              control.disabled = true;
            }
          });
        });
      });
    })();
  </script>
</body>
</html>
